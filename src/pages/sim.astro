---
// 骰子樹模擬器：在骰子樹上逐顆解鎖、調等級，即時算出這套規劃要花多少核心與金幣。
//
// **刻意不做**：戰鬥／機率模擬、骰子強度評分、網址編碼分享、分支點數統計
// （Yuki 2026-08-23 指定）。進度存在 localStorage，重整會接續上次——這跟 /board 刻意不存
// 是相反的裁決，理由是模擬一棵 239 節點的樹是會做很久的事，而擺 5 顆骰子不是。
//
// 畫布跟 /tree 共用 src/lib/canvas/ 的 controller（見 src/scripts/sim.ts 的檔頭）：
// 節點／邊／標籤／狀態色／等級牌全部由 painter 畫成像素，**不是 DOM**，所以這一頁的
// `<style is:global>` 裡沒有、也不可能有任何 `.node`／`.edge` 規則——模擬器的狀態色
// （已取得／可取得／鎖住／三階邊）現在是 state.ts 的 `SimPaint` ＋ painter.ts，數值從
// 舊的 CSS 規則原封不動搬過去。canvas.css 只剩版面骨架與兩張 canvas 的定位。
//
// 升級費用表在建置期讀進來（data/passive-upgrade-cost.json），**不進 tree.json**——
// tier 是 (maxLevel, unlockCost.gold) 的純函數，那兩個欄位產物裡本來就有，複製一份
// costTier 欄位進去只是拿 gzip 預算換一個推得出來的值。
import Base from '../layouts/Base.astro';
import '../styles/canvas.css';
import { treeData as data } from '../lib/tree-data';
import { MYTHIC_CORES } from '../lib/currency';
import tablesRaw from '../../data/passive-upgrade-cost.json';
import { buildSimContext } from '../lib/sim';
import type { PassiveUpgradeCost, TreeData } from '../lib/types';

const tree = data as unknown as TreeData;
const tables = tablesRaw as unknown as PassiveUpgradeCost;

// 可選初始骰子的清單在建置期就算好：它是「unlockVia 非 cost 非 default 且不用付錢」的
// 節點，從資料推導而不是硬編碼 id——官方哪天多送一顆，unlock-exceptions 改一行這裡就跟著對。
const ctx = buildSimContext(tree, tables);
const byId = new Map(tree.nodes.map(n => [n.id, n]));
const optional = [...ctx.optional]
  .map(id => byId.get(id)!)
  .sort((a, b) => a.id.localeCompare(b.id));
---

<Base title="骰子樹-模擬器(beta)">
  <!-- 工具列浮在畫布上（同 /tree 的 #toolbar）。⚠️ 裡面每一項都是常駐的，undo／redo
       用 disabled 而不是收起來——「工具列的尺寸不准隨狀態改變」在這個 repo 已經記過三次。
       ⚠️ **手機版（≤720px）它不是頂端那一條，是從下緣升起的 sheet**（見下面媒體查詢裡的
       說明與量到的數字）。DOM 順序與桌機完全一樣，換的只有定位與 `.sim-menu-body` 的展開方式。 -->
  <div id="sim-toolbar">
    <!-- sheet 的把手兼關閉鈕，桌機 display:none。 -->
    <button type="button" id="sim-sheet-close" aria-label="收起工具列"><span class="sim-grip" aria-hidden="true"></span></button>
    <input id="sim-search" type="search" placeholder="搜尋骰子或符文" aria-label="搜尋節點" autocomplete="off" />

    <div class="sim-menu">
      <button type="button" id="sim-initial-toggle" aria-expanded="false" aria-controls="sim-initial-menu">
        初始骰子<span class="sim-count" id="sim-initial-count">0</span>
      </button>
      <div class="sim-menu-body" id="sim-initial-menu" hidden>
        <p class="note">這幾顆不用花資源，但要靠遊戲外的條件取得。勾起來代表你已經有了。</p>
        {optional.map(n => (
          <label class="sim-check">
            <input type="checkbox" data-initial={n.id} />
            <span>
              {n.name}
              <em>{n.unlockNote}</em>
            </span>
          </label>
        ))}
      </div>
    </div>

    <div class="sim-menu">
      <button type="button" id="sim-limit-toggle" aria-expanded="false" aria-controls="sim-limit-menu">
        資源上限
      </button>
      <div class="sim-menu-body" id="sim-limit-menu" hidden>
        <p class="note">填了之後，會超出的操作會被擋下來。留白＝不限。</p>
        <label class="sim-field">核心 <input id="sim-limit-core" type="number" min="0" step="1" inputmode="numeric" /></label>
        <label class="sim-field">金幣 <input id="sim-limit-gold" type="number" min="0" step="1" inputmode="numeric" /></label>
        {MYTHIC_CORES.map(d => (
          <label class="sim-field">{d.label} <input id={`sim-limit-${d.kind}`} type="number" min="0" step="1" inputmode="numeric" /></label>
        ))}
      </div>
    </div>

    <button type="button" id="sim-undo" disabled aria-label="復原">↶</button>
    <button type="button" id="sim-redo" disabled aria-label="重做">↷</button>
    <button type="button" id="sim-abilities">能力彙總</button>
    <button type="button" id="sim-export">匯出</button>
    <button type="button" id="sim-reset">重置</button>
  </div>

  <div id="canvas-host">
    <script>
      import '../scripts/sim.ts';
    </script>
  </div>

  <!-- 手機版工具列的兩顆入口（桌機 display:none）。🔍 只升起搜尋那一列（畫布仍然看得見
       ——邊打字邊看節點淡出是這一頁搜尋唯一的回饋），⋯ 升起整份。
       ⚠️ 位置綁 `--sim-panel-h`（抽屜量出來的實際高度）而不是寫死偏移量，見
       「版面沒有固定偏移量」；抽屜被拖高時它們要跟著上移，否則會被蓋住而真人點不到
       ——「浮動 UI 被畫布外、z-index 更高的兄弟元素蓋掉」在這個 repo 已經咬過兩次。 -->
  <div id="sim-fabs">
    <button type="button" id="sim-fab-search" aria-expanded="false" aria-controls="sim-toolbar" aria-label="搜尋節點">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6" /><path d="M15.6 15.6 21 21" /></svg>
    </button>
    <button type="button" id="sim-fab-more" aria-expanded="false" aria-controls="sim-toolbar" aria-label="工具與設定">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="1.7" /><circle cx="12" cy="12" r="1.7" /><circle cx="19" cy="12" r="1.7" /></svg>
    </button>
  </div>

  <!-- sheet 升起時蓋住畫布的遮罩，點它收起。桌機 display:none。 -->
  <div id="sim-scrim" hidden></div>

  <!-- 側欄常駐顯示資源合計——那是這一頁存在的理由，不該藏在要點開的地方。
       選了節點時下半部才出現詳情。手機版整個變成**可拖曳高度**的底部抽屜：預設只露出
       把手那一列（總計與已取得仍然看得到，只是分項收在下面），拖上來才是完整側欄。 -->
  <aside id="sim-panel">
    <!-- 抽屜把手（桌機 display:none）：拖曳改高度、點一下收合／展開。
         ⚠️ 它是收起狀態下唯一看得到的一列，高度固定不隨狀態變（同工具列那條）。 -->
    <button type="button" id="sim-panel-handle" aria-expanded="false" aria-label="展開資源合計">
      <span class="sim-grip" aria-hidden="true"></span>
      <span class="sim-head-sum">
        <span id="sim-head-cost">核心 0 ／金幣 0</span>
        <span id="sim-head-owned">5 / {tree.nodes.length}</span>
      </span>
    </button>
    <div id="sim-totals">
      <h2>資源合計</h2>
      <dl>
        <div class="sim-total-row is-total"><dt>總計</dt><dd id="sim-total">核心 0 ／金幣 0</dd></div>
        <div class="sim-total-row"><dt>解鎖</dt><dd id="sim-total-unlock">核心 0 ／金幣 0</dd></div>
        <div class="sim-total-row"><dt>升級</dt><dd id="sim-total-upgrade">核心 0 ／金幣 0</dd></div>
        <div class="sim-total-row"><dt>已取得</dt><dd id="sim-owned-count">5 / {tree.nodes.length}</dd></div>
      </dl>
      <p id="sim-limit-warn" class="warn" hidden></p>
    </div>
    <div id="sim-detail" class="empty">
      <p class="note">點畫布上的節點看它的詳情；前置都解開的節點點一下就會取得。</p>
    </div>
  </aside>

  <div id="sim-ability-modal" hidden>
    <div class="sim-modal-box" role="dialog" aria-modal="true" aria-labelledby="sim-ability-title">
      <div class="sim-modal-head">
        <h2 id="sim-ability-title">能力彙總</h2>
        <button type="button" id="sim-ability-close" aria-label="關閉">✕</button>
      </div>
      <div id="sim-ability-body"></div>
    </div>
  </div>

  <p id="sim-toast" role="status" aria-live="polite"></p>
</Base>

<style is:global>
  /* ⚠️ 一律 is:global：畫布上的節點是 JS 在執行期產生的，Astro 的 scoped 樣式靠建置期加在
     標記上的 data 屬性生效，動態元素拿不到那個屬性（tree.astro 同一段註解）。 */

  /* --- 工具列 --------------------------------------------------------------- */
  #sim-toolbar {
    position: fixed;
    top: var(--nav-h, 3rem);
    left: 0;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: var(--surface-2);
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    border-bottom-right-radius: var(--r-md);
    box-shadow: var(--shadow-3);
  }

  #sim-toolbar input[type='search'],
  #sim-toolbar input[type='number'] {
    padding: var(--space-1) var(--space-2);
    font-size: var(--fs-md);
    color: var(--fg);
    background: var(--surface-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
  }

  #sim-toolbar input[type='search'] {
    width: 11rem;
  }

  #sim-toolbar button {
    padding: var(--space-1) var(--space-3);
    font-size: var(--fs-md);
    color: var(--fg);
    cursor: pointer;
    background: var(--surface-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
    transition:
      background var(--t-fast) var(--e-out),
      transform var(--t-press) var(--e-out);
  }

  #sim-toolbar button:hover:not(:disabled) {
    background: var(--surface-3);
  }

  /* 按下去縮一下（2026-08-26 PR ⑥）。⚠️ `:not(:disabled)`：模擬器的按鈕會在跑不動的時候
     停用，按不動的東西不該有按下去的回饋。 */
  #sim-toolbar button:not(:disabled):active {
    transform: scale(var(--p-press));
  }

  #sim-toolbar button:disabled {
    color: var(--muted);
    cursor: default;
    opacity: 0.55;
  }

  /* 勾了幾顆初始骰子。⚠️ 這個徽章**一直存在**，沒勾時顯示 0 而不是收起來——只在有值時才
     長出來的話按鈕寬度會隨狀態跳動（同 /tree 金點那條）。 */
  .sim-count {
    display: inline-block;
    min-width: 1.4em;
    margin-left: var(--space-1);
    padding: 0 var(--space-h);
    font-size: var(--fs-xs);
    text-align: center;
    background: var(--surface-3);
    border-radius: var(--r-pill);
  }

  /* --- 下拉選單 ------------------------------------------------------------- */
  /* 用絕對定位浮出去，不是撐開工具列：展開會改變工具列高度的話，整排東西會在點下去的
     那一刻跳一次。 */
  .sim-menu {
    position: relative;
  }

  .sim-menu-body {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    z-index: 6;
    width: max-content;
    /* ⚠️ 上界必須夾到視口內。原本只寫 `max-width: 22rem`，而定位只有 `left: 0`——
       在 390px 寬的螢幕上實測「資源上限」的選單 left 245 ＋ width 302 ＝ 右緣 547，
       五個數字輸入框整排落在畫面外、完全摸不到（「初始骰子」右緣 482，同一個成因）。
       桌機用不到這個夾制（100vw − 兩側邊距 ≥ 697px > 352px），computed style 不變。 */
    max-width: min(22rem, calc(100vw - var(--space-3) * 2));
    padding: var(--space-3);
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-3);
  }

  .sim-menu-body .note {
    margin: 0 0 var(--space-2);
    color: var(--muted);
    font-size: var(--fs-xs);
  }

  .sim-check {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    padding: var(--space-1) 0;
    cursor: pointer;
  }

  .sim-check em {
    display: block;
    color: var(--muted);
    font-size: var(--fs-xs);
    font-style: normal;
  }

  .sim-field {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-1) 0;
    font-size: var(--fs-md);
  }

  .sim-field input {
    width: 8rem;
  }

  /* 超出上限時把輸入框標紅。--nature 是站台既有的警示色用法（見 #detail .warn）。 */
  #sim-toolbar input.over-limit {
    border-color: var(--nature);
  }

  /* --- 手機版專屬的元件在桌機一律收起來 --------------------------------------
     它們只在 ≤720px 的媒體查詢裡被打開（見檔尾「手機版」那節）。寫在這裡而不是
     只寫在媒體查詢裡：沒有這一條，桌機會多出兩顆浮動鍵、一片遮罩與一條把手。 */
  #sim-fabs,
  #sim-scrim,
  #sim-sheet-close,
  #sim-panel-handle {
    display: none;
  }

  /* --- 側欄 ----------------------------------------------------------------- */
  #sim-panel {
    position: fixed;
    top: var(--nav-h, 3rem);
    right: 0;
    bottom: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    width: 22rem;
    padding: var(--space-3);
    overflow-y: auto;
    background: var(--surface-2);
    border-left: 1px solid var(--border);
    box-shadow: var(--shadow-3);
  }

  #sim-totals h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-lg);
  }

  #sim-totals dl {
    margin: 0;
  }

  .sim-total-row {
    display: flex;
    gap: var(--space-2);
    justify-content: space-between;
    padding: var(--space-h) 0;
    font-size: var(--fs-md);
  }

  .sim-total-row dt {
    color: var(--muted);
  }

  .sim-total-row dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .sim-total-row.is-total {
    padding-bottom: var(--space-2);
    font-size: var(--fs-base);
    font-weight: 600;
    border-bottom: 1px solid var(--border);
  }

  #sim-limit-warn {
    margin: var(--space-2) 0 0;
    color: var(--nature);
    font-size: var(--fs-sm);
  }

  #sim-detail {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  #sim-detail h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--fs-lg);
  }

  #sim-detail .tag {
    display: inline-block;
    margin-right: var(--space-1);
    padding: var(--space-h) var(--space-2);
    color: var(--muted);
    font-size: var(--fs-xs);
    background: var(--surface-3);
    border-radius: var(--r-pill);
  }

  #sim-detail .desc {
    margin: var(--space-2) 0;
    font-size: var(--fs-md);
    line-height: 1.6;
  }

  /* 關鍵字標記。/tree 的版本是可點的按鈕（推出詞彙視圖），這一頁只上色不可點。 */
  #sim-detail .sim-term {
    color: var(--support);
    text-decoration: underline dotted currentcolor;
    text-underline-offset: 0.2em;
  }

  #sim-detail .note {
    margin: var(--space-1) 0;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  #sim-detail .warn {
    color: var(--nature);
  }

  #sim-detail .cta {
    display: block;
    width: 100%;
    margin-top: var(--space-2);
    padding: var(--space-2);
    color: var(--bg);
    font-size: var(--fs-md);
    font-weight: 600;
    cursor: pointer;
    background: var(--gold);
    border: none;
    border-radius: var(--r-sm);
  }

  #sim-detail .cta.danger {
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--nature);
  }

  #sim-detail .cta:disabled {
    color: var(--muted);
    cursor: default;
    background: var(--surface-3);
  }

  /* --- 等級調整 ------------------------------------------------------------- */
  .sim-level {
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
  }

  .sim-level-row {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }

  .sim-level-row input[type='range'] {
    flex: 1;
    min-width: 0;
  }

  .sim-level-row button {
    width: 2rem;
    padding: var(--space-1);
    color: var(--fg);
    cursor: pointer;
    background: var(--surface-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
  }

  .sim-level-value {
    min-width: 5em;
    font-size: var(--fs-md);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  /* --- 能力彙總 ------------------------------------------------------------- */
  #sim-ability-modal {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    background: rgb(0 0 0 / 55%);
  }

  #sim-ability-modal[hidden] {
    display: none;
  }

  .sim-modal-box {
    display: flex;
    flex-direction: column;
    width: min(38rem, 100%);
    max-height: 80vh;
    padding: var(--space-4);
    overflow-y: auto;
    background: var(--surface-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-3);
  }

  .sim-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .sim-modal-head h2 {
    margin: 0;
    font-size: var(--fs-xl);
  }

  .sim-modal-head button {
    padding: var(--space-1) var(--space-2);
    color: var(--fg);
    font-size: var(--fs-lg);
    cursor: pointer;
    background: none;
    border: none;
  }

  .sim-ability-group {
    margin-bottom: var(--space-4);
  }

  .sim-ability-group h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-md);
    color: var(--muted);
  }

  .sim-ability-row {
    display: flex;
    gap: var(--space-3);
    justify-content: space-between;
    padding: var(--space-1) 0;
    font-size: var(--fs-md);
    border-bottom: 1px solid var(--border);
  }

  .sim-ability-row strong {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .sim-ability-empty {
    color: var(--muted);
    font-size: var(--fs-md);
  }

  /* --- toast ---------------------------------------------------------------- */
  #sim-toast {
    position: fixed;
    bottom: var(--space-6);
    left: 50%;
    z-index: 30;
    margin: 0;
    padding: var(--space-2) var(--space-4);
    color: var(--bg);
    font-size: var(--fs-md);
    background: var(--gold);
    border-radius: var(--r-pill);
    box-shadow: var(--shadow-2);
    transform: translateX(-50%);
  }

  /* ⚠️ 不要用 `[hidden]`／`display:none`／`visibility:hidden` 收這個元素：它是這一頁唯一的
     `role="status"`，那三種收法會讓它一併從無障礙樹消失，於是「超出資源上限」這些唯一的
     失敗回饋對螢幕閱讀器完全不存在。改成內容空的時候只收視覺（元素本身一直在）。 */
  #sim-toast:empty {
    padding: 0;
    background: none;
    box-shadow: none;
  }

  /* --- 手機版 --------------------------------------------------------------- */
  /*
   * 2026-09-22 重排。改之前在 390×844（Pixel 7 視口）量到的版面：
   *   nav 50.6 ＋ 工具列 87（兩列、fixed、蓋在 #canvas-host 頂端）
   *   ＋ footer 著作權 73 ＋ 抽屜 354（其中「資源合計」四列固定佔 152）
   *   → **畫布只剩 368px ／ 844 ＝ 44%**，而且被工具列蓋住的那 87px 裡的節點點不到。
   * 改之後：工具列收成底部 sheet（兩顆浮動鍵當入口）、抽屜預設只露出把手那一列、
   * 著作權搬進抽屜最底 → 畫布約 89%。
   *
   * ⚠️ 仍然**不能**用 `overflow-x: auto` 把工具列變成一條橫捲的列：第一版那樣做，390px
   * 寬的螢幕上「重置」之後的按鈕整批看不到，而畫面上沒有任何東西告訴使用者可以往右滑
   * ——看不到的按鈕等於不存在。sheet 是**縱向**可捲的，每一顆都在視線裡。
   */
  @media (width <= 720px) {
    /* 工具列＝從下緣升起的 sheet。收起時整個移出畫面**並且 visibility: hidden**——它是
       真的關著，裡面的搜尋框與五個上限輸入框不該還能被 Tab 走到。
       （`#sim-toast` 那條「不准用 visibility 收」講的是這一頁唯一的 role="status"，
       不是這裡：sheet 關著的時候它的內容本來就不該被播報。） */
    #sim-toolbar {
      top: auto;
      right: 0;
      bottom: 0;
      z-index: 7;
      max-height: 80dvh;
      padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
      overflow-y: auto;
      visibility: hidden;
      border-right: none;
      border-bottom: none;
      border-top: 1px solid var(--border-strong);
      border-radius: var(--r-lg) var(--r-lg) 0 0;
      transform: translateY(101%);
    }

    /* ⚠️ 過場只掛在開啟那一側（升起時滑上來、收起時直接收掉）。
       `visibility` 是離散屬性，放進 transition 就得自己指定翻轉時機，而這個 repo 的
       「每一條 transition 都要指名 token 曲線」只收 `--e-*`／`--slide-ease`，
       `step-end` 過不了那道閘（`tests/styles/tokens.test.ts`）。收起不做動畫也跟遮罩
       一致——遮罩本來就是 `[hidden]` 一翻就不見。 */
    #sim-toolbar.is-open {
      visibility: visible;
      transform: translateY(0);
      transition: transform var(--t-med) var(--e-out);
    }

    /* 🔍 那一顆只升起搜尋列：sheet 只有把手與搜尋框兩個孩子露出來，畫布仍然看得見。 */
    #sim-toolbar.is-search > :not(#sim-search):not(#sim-sheet-close) {
      display: none;
    }

    #sim-toolbar input[type='search'] {
      flex: 1;
      min-width: 6rem;
    }

    /* 把手佔滿一列（`#sim-toolbar` 是 flex-wrap）。內距要指名到 id 才蓋得過
       `#sim-toolbar button` 的 (1,0,1)。 */
    #sim-toolbar #sim-sheet-close {
      display: flex;
      flex-basis: 100%;
      justify-content: center;
      padding: var(--space-1) 0;
      background: none;
      border: none;
      box-shadow: none;
    }

    /* 兩個下拉在 sheet 裡**就地展開**，不再是絕對定位的浮層——浮層在 390px 上會整片溢出
       右邊界（見上面 `.sim-menu-body` 那條的實測數字）。就地展開會把 sheet 撐高，而
       sheet 本來就是可捲的，不像工具列撐高會讓整排東西跳。 */
    .sim-menu {
      flex-basis: 100%;
    }

    .sim-menu > button {
      width: 100%;
    }

    .sim-menu-body {
      position: static;
      width: auto;
      max-width: none;
      margin-top: var(--space-2);
      box-shadow: none;
    }

    .sim-field input {
      width: 7rem;
    }

    /* 抽屜：高度由把手拖曳決定（`--sim-panel-user-h`，存在 localStorage），
       預設＝把手自己那一列。上限 80dvh。
       ⚠️ 不寫 max-height 之外的固定偏移量——這個 repo 的寫死偏移量已經咬過五次。 */
    #sim-panel {
      top: auto;
      width: 100%;
      height: var(--sim-panel-user-h, 3.5rem);
      max-height: 80dvh;
      /* ⚠️ 下內距要搬到最後一個孩子身上，不能留在抽屜上：`box-sizing: border-box` 之下
         它會從 3.5rem 裡扣掉，把手（3.5rem）就溢出到收起高度之外，「總計」那一列會從
         把手底下露出半行。 */
      padding: 0 var(--space-3);
      overscroll-behavior: contain;
      border-top: 1px solid var(--border);
      border-left: none;
    }

    #sim-panel > :last-child {
      margin-bottom: var(--space-3);
    }

    /* ⚠️ 抽屜是 flex column，而 flex 子項預設 `flex-shrink: 1`：抽屜收到 3.5rem 時把手
       會被壓扁，「總計」那一列就從它底下露出半行（實測露約 30px）。收起狀態下的高度是
       刻意夾出來的，子項一律不准被壓縮，超出的部分交給 `overflow-y: auto`。 */
    #sim-panel > * {
      flex: none;
    }

    #sim-panel-handle {
      display: flex;
      position: sticky;
      top: 0;
      z-index: 1;
      flex-direction: column;
      gap: var(--space-1);
      justify-content: center;
      /* 固定高度：收起時它是唯一看得到的一列，尺寸隨狀態跳動的話整個抽屜會抖。
         這個值同時是抽屜高度的下限，由 sim.ts 量它、不另外寫死第二份數字。 */
      width: 100%;
      height: 3.5rem;
      padding: 0;
      color: var(--fg);
      cursor: grab;
      background: var(--surface-2);
      border: none;
      /* 拖曳要自己收 pointermove，不能讓瀏覽器先把它當成捲動手勢吃掉。 */
      touch-action: none;
    }

    #sim-panel-handle:active {
      cursor: grabbing;
    }

    .sim-grip {
      align-self: center;
      width: 2.25rem;
      height: 0.25rem;
      background: var(--border-strong);
      border-radius: var(--r-pill);
    }

    .sim-head-sum {
      display: flex;
      gap: var(--space-2);
      justify-content: space-between;
      width: 100%;
      font-size: var(--fs-md);
      font-variant-numeric: tabular-nums;
    }

    /* 收起狀態下把手已經講完總計與已取得，標題再重複一次只是佔位。 */
    #sim-totals h2 {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* 著作權：由 sim.ts 把 <footer> 搬進抽屜最底（見該處說明）。搬進來之後它不再是
       body 的直屬子節點，下面那條讓位規則自動失效——那正是要的。 */
    #sim-panel > footer {
      margin-top: var(--space-4);
      padding-top: var(--space-3);
      border-top: 1px solid var(--border);
    }

    /* 沒有 JS 時 footer 還留在原處，抽屜（fixed bottom:0）會疊在它上面。
       高度用 sim.ts 量出來的實際值，不寫死數字。 */
    body:has(#canvas-host) > footer {
      padding-bottom: calc(var(--space-4) + var(--sim-panel-h, 3.5rem));
    }

    /* 兩顆浮動鍵。`bottom` 綁抽屜的實際高度：拖高時跟著上移，永遠浮在抽屜上緣之上。 */
    #sim-fabs {
      display: flex;
      position: fixed;
      right: var(--space-3);
      bottom: calc(var(--sim-panel-h, 3.5rem) + var(--space-3));
      z-index: 6;
      flex-direction: column;
      gap: var(--space-2);
      transition: bottom var(--t-fast) var(--e-out);
    }

    #sim-fabs button {
      display: grid;
      /* 固定尺寸（44px＝可點區域下限）：浮動鍵不准隨狀態改變大小。 */
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      color: var(--fg);
      cursor: pointer;
      background: var(--surface-2);
      border: 1px solid var(--border-strong);
      border-radius: var(--r-pill);
      box-shadow: var(--shadow-3);
      place-items: center;
      transition: transform var(--t-press) var(--e-out);
    }

    #sim-fabs button:active {
      transform: scale(var(--p-press));
    }

    #sim-fabs svg {
      width: 1.25rem;
      height: 1.25rem;
      fill: none;
      stroke: currentcolor;
      stroke-width: 2;
      stroke-linecap: round;
    }

    #sim-fab-more svg {
      fill: currentcolor;
      stroke: none;
    }

    /* 遮罩從導覽列下緣開始：nav 仍然要點得到。
       ⚠️ `z-index: 5` 必須**低於** `#sim-fabs` 的 6：兩者同為 6 時由 DOM 順序決勝，而遮罩
       排在後面——搜尋模式下 sheet 只有一列高、兩顆浮動鍵明明露在它上方，`elementFromPoint`
       卻回 `#sim-scrim`，於是「⋯ 開著時按 🔍 換模式」那條路用指標永遠走不到
       （2026-09-22 /code-review 抓到，同一族的「浮動 UI 被兄弟元素蓋掉」第三次）。
       仍然高於 `#sim-panel` 的 4：sheet 開著時抽屜本來就該被擋住。 */
    #sim-scrim {
      display: block;
      position: fixed;
      inset: var(--nav-h, 3rem) 0 0;
      z-index: 5;
      background: rgb(0 0 0 / 45%);
    }

    /* ⚠️ 這條要排在上面那條後面：`[hidden]` 的 UA 預設 `display: none` 具體度是 (0,1,0)，
       會輸給 `#sim-scrim` 的 (1,0,0)，少了它遮罩會永遠蓋著畫布。 */
    #sim-scrim[hidden] {
      display: none;
    }
  }

  /* 減少動態：模擬器這一份。理由與寫法見 chrome.css 檔尾同一段。
     ⚠️ 這一頁 2026-08-26 之前沒有這一段（它只有一條沒有曲線的 background 過場）；
     PR ⑥ 給按鈕加上按壓回饋之後才需要。 */
  @media (prefers-reduced-motion: reduce) {
    #sim-toolbar button {
      transition: none;
    }
    /* ⚠️ 選擇器要跟上面那條**一模一樣**，`:not(:disabled)` 也要帶上：
       `#sim-toolbar button:not(:disabled):active` 是 (1,2,1)，少了 `:not()` 只有 (1,1,1)，
       會被壓過去。2026-08-26 實測踩到——reduce 之下按鈕照樣縮，是 code review 抓出來的，
       而 D18 當時沒有把 /sim 列進去、D14 只驗 transition-duration 不驗 transform。 */
    #sim-toolbar button:not(:disabled):active {
      transform: none;
    }

    /* 手機版新增的三段過場。⚠️ 選擇器要跟被覆寫的那幾條**一模一樣**（含 `.is-open`），
       少一階具體度就會輸掉——同一族坑 2026-08-26 在這一頁踩過一次。 */
    @media (width <= 720px) {
      #sim-toolbar.is-open {
        transition: none;
      }

      #sim-fabs {
        transition: none;
      }

      #sim-fabs button:active {
        transform: none;
      }
    }
  }
</style>
