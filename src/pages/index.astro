---
// 首頁：版本與更新日期全部從 src/generated/tree.json 讀出，不寫死，資料改版時自動同步。
import Base from '../layouts/Base.astro';
import data from '../generated/tree.json';
import changelogRaw from '../../data/changelog.json';
import type { Changelog } from '../lib/changelog';

const changelog = changelogRaw as Changelog;
// 首頁只放最新 3 筆。更久以前的東西對「這個站最近有沒有在動」沒有幫助，卻會把首頁撐長，
// 把底下的入口推到摺線以下。
const recent = changelog.entries.slice(0, 3);
const diceCount = data.nodes.filter(n => n.type === 'dice').length;

// 全分支 review I2：純站台功能的更新（例如這一頁本身、/board）常常排在最前面，卻沒有資料
// 版本可言——recent 的前 3 筆完全可能一筆帶 data 的都沒有。跟規則 20（src/lib/changelog.ts
// 的 checkChangelog）同一套語意，找的是「最新一筆帶 data 的條目」而不是 entries[0] 或
// recent 裡有沒有：純功能更新排到最前面，不代表資料版本戳記就該從畫面上消失。
const latestDataEntry = changelog.entries.find(e => e.data);
const latestDataStamp = latestDataEntry?.data;
// recent 裡如果本來就有這一筆（帶 data 的條目仍在最新 3 筆之內），下面的逐筆渲染已經會印出
// 戳記，不需要再另外補一次；`.includes` 比對的是同一個物件參照（recent 是 entries 的
// slice，find 也是掃同一個 entries），不是內容相等。
const latestDataInRecent = latestDataEntry !== undefined && recent.includes(latestDataEntry);
---

<Base title="首頁">
  <section class="page home-hero">
    <h1>Random Dice 2 wiki</h1>
    <div class="home-links">
      <a class="home-card" href="/tree">
        <h2>骰子樹 →</h2>
        <p>可平移縮放的全樹畫布，點節點看前置鏈與累計解鎖成本。</p>
      </a>
      <a class="home-card" href="/dice">
        <h2>骰子圖鑑 →</h2>
        <p>{diceCount} 顆骰子的基本效果與 7 骰點覺醒，一頁看完。</p>
      </a>
      <a class="home-card" href="/guide">
        <h2>遊戲介紹 →</h2>
        <p>骰子描述裡那些帶 # 的官方標記是什麼意思。</p>
      </a>
    </div>

    <!-- 遊戲版本是玩家在遊戲裡看得到的號碼，更新日期是這個站最後一次跟上游對過資料的日子。
         兩個都讀自資料正本（<svg> 的 data-game-version／data-updated），不寫死在頁面上——
         寫死的版本號一定會忘記跟著改。

         ⚠️ 資源包版本（meta.gameBundle）**刻意不顯示**（2026-08-22 Yuki 指定）：那是「這份
         資料抄自哪一版遊戲資源包」，只有維護資料的人在意，玩家看了只會多一個看不懂的號碼。
         它仍然存在於資料正本與 data/changelog.json 裡，規則 20 照樣拿它擋 CI，只是不上頁面。

         ⚠️ id 是 tests/e2e/tree.spec.ts 的 T 抓的目標。那條測試原本抓的是 `section`，
         首頁一多一個區塊就會踩到 Playwright 的 strict mode；選擇器綁版面結構本來就撐不住
         版面改動，所以改綁這個 id。 -->
    <p id="version-info" class="muted">
      遊戲版本v{data.meta.gameVersion}（更新於 {data.meta.updated}）
    </p>
  </section>

  <section class="page home-changelog">
    <h2>更新日誌</h2>
    {recent.map(entry => (
      <article class="log-entry">
        <p class="log-head">
          <time datetime={entry.date}>{entry.date}</time>
          <strong>{entry.title}</strong>
          {/* 只印遊戲版本。資源包版本留在 data/changelog.json 給規則 20 用，不上頁面。 */}
          {entry.data && <span class="log-stamp">遊戲 v{entry.data.gameVersion}</span>}
        </p>
        <ul>{entry.items.map(item => <li>{item}</li>)}</ul>
      </article>
    ))}
    <!-- 全分支 review I2：資料版本戳記跟規則 20 同一套語意（最新一筆帶 data 的條目），
         不是「entries[0] 帶不帶 data」也不是「recent 裡有沒有」。純功能更新排在最前面時
         （目前就是這樣：/board 上線在 entries[0]），最新 3 筆逐條渲染完全不會印出戳記——
         這裡補一行，不讓資料版本從畫面上消失，也不用為了湊「剛好落在前 3 筆」去動排序。 -->
    {!latestDataInRecent && latestDataEntry && latestDataStamp && (
      <p class="note">
        資料版本 <span class="log-stamp">遊戲 v{latestDataStamp.gameVersion}</span>
        （{latestDataEntry.date} {latestDataEntry.title} 對過資料表）
      </p>
    )}
    <!-- 目前全部條目就這幾筆，還不需要一頁完整記錄；筆數長起來之後再開 /changelog。 -->
    {changelog.entries.length > recent.length && (
      <p class="note">另有 {changelog.entries.length - recent.length} 筆較早的更新。</p>
    )}

    <!-- 訪客計數器。
         預設 hidden，拿到數字才顯示——但 hidden 在 global.css 裡被改成
         visibility: hidden（保留高度），所以顯示與否都不會讓下面的 footer 跳動。 -->
    <p id="hit-counter" hidden>
      你是第<span id="hit-number"></span>位訪客
    </p>
  </section>
</Base>

<script>
  // 數字只能在瀏覽器端取得：站台是 output: 'static'，頁面在建置期產生、由邊緣快取送出，
  // render 的時候不可能知道「這次訪問」。
  import { fetchHitNumber } from '../lib/hit-counter';

  const block = document.getElementById('hit-counter');
  const slot = document.getElementById('hit-number');
  if (block && slot) {
    fetchHitNumber().then(n => {
      // null = 顯示不出來（endpoint 不在、逾時、CSP 擋下、儲存被拒……）。
      // 一律保持 hidden，不顯示 0，也不留一個空的數字框。
      if (n === null) return;
      slot.textContent = n.toLocaleString('en-US');
      block.removeAttribute('hidden');
    });
  }
</script>
