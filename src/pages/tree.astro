---
// 骰子樹畫布頁：239 個節點、248 條邊的靜態結構 + 平移縮放（滑鼠/雙指/鍵盤）+
// 選取/前置鏈高亮/詳情面板 + 搜尋/篩選/網址狀態同步。
// 掛載邏輯放在 src/scripts/tree-canvas.ts，方便各任務在同一支腳本上疊加互動。
import Base from '../layouts/Base.astro';

// 分支（5 個，spec §6.3）與類型（4 個）在編譯期就是固定的字面聯集，不是要跑期才知道的
// 節點資料，所以直接在這裡的 frontmatter 迴圈產生 checkbox 標記（Astro 本來就是做這件事
// 的地方），不另外開一支 src/components/FilterBar.ts 純字串產生器——沒有需要在瀏覽器沒有
// 的環境下單獨單元測試的邏輯（不像 NodeDetail.ts 有 HTML escape、關鍵字白名單比對這些
// 值得鎖住的行為），見 task-16-report.md「FilterBar.ts 的取捨」一節。
// value 用的字串必須跟 src/lib/types.ts 的 Branch / NodeType 字面聯集完全對應，
// 因為 tree-canvas.ts 會直接把 dataset 值當 Branch/NodeType 塞進 FilterState。
const BRANCHES: Array<[string, string]> = [
  ['nature', '自然'],
  ['engineering', '工學'],
  ['magic', '魔法'],
  ['order', '秩序'],
  ['chaos', '渾沌'],
];
const TYPES: Array<[string, string]> = [
  ['dice', '骰子'],
  ['rune', '骰子符文'],
  ['passive', '玩家被動'],
  ['support', '支援'],
];
---

<Base title="骰子樹">
  <!-- #tree-controls：把 #toolbar 與 #branch-nav 包進同一個 position:fixed 的直向
       flex 容器（修 bug：舊版兩者各自用寫死的 top 值疊放，#branch-nav 的 top:6rem
       假設 #toolbar 永遠只有 3rem 高，但 #toolbar 有 flex-wrap，視窗變窄換行變高後
       #branch-nav 就會壓上去）。改成同一個 flex column 容器後，#branch-nav 永遠緊接
       在 #toolbar 實際渲染高度之後，不論 #toolbar 換幾行都不會重疊。#tree-controls
       本身不是既有 DOM 契約的一部分，純粹是版面用的包裝元素，tree-canvas.ts／E2E
       完全不吃這個 id，只吃裡面兩個原本就有的 id。 -->
  <div id="tree-controls">
    <div id="toolbar">
      <!-- 手機版才顯示（見下面 CSS）：篩選收進頂部抽屜，預設收起，點這顆按鈕展開/收起
           #filters（切 .open class，接線見 tree-canvas.ts）。桌機版 #filters 本來就常駐
           顯示，不需要這顆按鈕，靠 CSS 媒體查詢隱藏。 -->
      <button id="filters-toggle" type="button" aria-label="展開篩選" aria-controls="filters">篩選</button>
      <input id="search" type="search" placeholder="搜尋節點名稱、效果、關鍵字…" aria-label="搜尋節點" />
      <!-- 篩選狀態列。沒有篩選時整個隱藏；一旦有條件就顯示「符合 N 個」與清除鈕。
           沒有它的時候，搜尋只符合少數幾個節點會變成「整片變灰、看不出哪裡有東西、也不知道
           怎麼回去」——點關鍵字進來的人尤其容易卡住（2026-08-18 人工檢視 image9 回報）。
           role="status" 讓螢幕閱讀器在數字變動時唸出來。 -->
      <p id="filter-status" role="status" hidden>
        <span id="filter-count"></span>
        <button id="filter-clear" type="button">清除篩選</button>
      </p>
      <div id="filters">
        <fieldset>
          <legend>分支</legend>
          {BRANCHES.map(([value, label]) => (
            <label><input type="checkbox" data-branch={value} /> {label}</label>
          ))}
        </fieldset>
        <fieldset>
          <legend>類型</legend>
          {TYPES.map(([value, label]) => (
            <label><input type="checkbox" data-type={value} /> {label}</label>
          ))}
        </fieldset>
      </div>
    </div>
    <!-- 桌機側欄的分支快速跳轉（spec §6.2.6）：跟下面手機版 #branch-chips 是同一組分支、
         同一個按鈕點擊 handler（見 tree-canvas.ts 的 jumpToBranch()，不寫兩份跳轉邏輯），
         只是版面位置與顯示時機不同（CSS 媒體查詢互斥顯示）。 -->
    <nav id="branch-nav" aria-label="分支快速跳轉">
      {BRANCHES.map(([value, label]) => (
        <button type="button" data-branch={value}>{label}</button>
      ))}
    </nav>
  </div>
  <div id="canvas-host">
    <script>
      import '../scripts/tree-canvas.ts';
    </script>
  </div>
  <aside id="detail" hidden></aside>
  <!-- 手機版底部的分支切換列（DOM 契約，見 task-17 brief：#branch-chips 內含 5 個
       button[data-branch]，第 18 個任務的 E2E 已經寫死這個結構）。 -->
  <div id="branch-chips">
    {BRANCHES.map(([value, label]) => (
      <button type="button" data-branch={value}>{label}</button>
    ))}
  </div>
</Base>

<style is:global>
  /* 畫布頁不要吃到 Base.astro 版面預設的 <main> 內距／寬度上限，
     其餘頁面（首頁、貢獻頁）維持原本的閱讀寬度不受影響。

     ⚠️ 這一組（body / main / #canvas-host）是「畫布剛好填滿 nav 與 footer 之間」的**唯一**
     機制，不要再往裡面加任何 px 偏移量。舊版寫的是 `height: calc(100vh - 110px)`，而 nav
     實測 50.59 ＋ footer 114.88 ＝ 165.47（手機）／50.59 ＋ 73.94 ＝ 124.53（桌機）——
     每個尺寸多出 15～55px 的捲動，捲到底時 fixed 的 #tree-controls 會跟 nav 之間裂開一條縫、
     手機版 #branch-chips 壓在 footer 上。這是「寫死版面偏移量」在這個 repo 咬人的第四次
     （前三次見 #tree-controls 那條規則的註解與 CLAUDE.md）。

     改成讓 <main> 吃掉 nav 與 footer 之外的剩餘空間：
     - min-height 用 100dvh（行動瀏覽器的網址列會伸縮，100vh 量的是「網址列收起時」的高度，
       在網址列展開時會多出一截）；100vh 留一行當不支援 dvh 時的 fallback。
     - main 的 `min-height: 0` 不能省：flex 子元素的預設 min-height 是 auto，SVG 會把 main
       撐開到內容高度，剩餘空間就白算了。 */
  body:has(#canvas-host) {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100dvh;
  }

  main:has(#canvas-host) {
    max-width: none;
    padding: 0;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    /* global.css 的 `main { margin: 0 auto }` 是給內容頁置中用的。body 一旦變成 flex column，
       水平方向的 auto 邊界會**取消 stretch**：main 不再撐滿寬度，而是縮到內容寬——裡面只有一張
       沒有內建尺寸的 SVG，於是整個畫布縮成瀏覽器預設的 300px 寬。這兩行把它扳回來。 */
    margin-inline: 0;
    width: 100%;
  }

  /* 用 flex: 1 而不是 height: 100%：百分比高度要求父層有「確定的」高度，而 main 的高度是
     flex 算出來的，瀏覽器解析百分比時拿不到那個值（實測會縮成 255px）。讓 #canvas-host
     自己也當 flex 子元素去分剩餘空間，就沒有百分比解析的問題。 */
  #canvas-host {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    touch-action: none;
    /* 給下面那張絕對定位的 SVG 當定位基準。 */
    position: relative;
  }

  /* ⚠️ 上面整條高度鏈都掛在 `:has()` 上。不支援 `:has()` 的引擎（Firefox 121 之前、較舊的
     WebKit）會把整條選擇器當成無效**整條丟掉**——body/main 不是 flex、`flex: 1` 沒有作用、
     而 #tree 是 absolute 對版面高度貢獻 0，結果 #canvas-host 高 0px，整頁一片空白且沒有
     任何錯誤訊息。改版前 `height: calc(100vh - 110px)` 是無條件的，退化時只是版面偏一點。
     這裡補一條 fallback：只在不支援 `:has()` 的引擎生效，畫布退回一個「不好看但看得到」的
     視窗比例高度。CLAUDE.md 記著本站只在 Chromium 驗過，這種整頁空白的失敗模式不能留。 */
  @supports not selector(:has(*)) {
    #canvas-host {
      height: 70vh;
    }
  }

  /* ⚠️ 絕對定位、不是 width/height: 100%。
     SVG 有內建的長寬比（viewBox 2000×1700），`height: 100%` 在父層高度還沒定案時會退回
     auto，於是它用「寬度 ÷ 長寬比」算出一個內在高度（1280 寬 → 1088 高）反過來把 <main>
     撐開——版面就又捲得動了，而且畫布比視窗還高。抽離普通流程後它對版面的高度貢獻是 0，
     大小完全由 #canvas-host 決定。 */
  #tree {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* 把整個畫布內容升成自己的合成層，讓平移退化成 GPU 對既有圖層做位移、完全不重畫。
     配合 src/lib/viewport.ts 的 apply() 改用 CSS transform（SVG 的 transform
     **attribute** 不會建立合成層，這兩件事要一起才有效，只做一半等於沒做）。

     2026-08-21 在真實 Windows 機器上用 A/B 測試頁實測（150 幀自動軌跡，239 節點全可見）：
       平移 0.75×：33 FPS／掉 63 幀  →  99 FPS／掉 1 幀
       平移 1.00×：50 FPS            →  100 FPS
       縮放 1.00×：33 FPS／掉 53／最長 90ms  →  50 FPS／掉 5／最長 40ms
     那條「0.75× 最慢、0.15× 與 1.50× 反而都快」的非單調曲線是決定性證據：光柵化成本
     正比於螢幕上實際要畫的像素面積，0.75× 剛好是整棵樹填滿視窗、239 個節點全部可見。

     ⚠️ will-change 是常駐的，不是拖曳時才加。這是刻意的：這個畫布的存在目的就是被一直
     平移縮放，動態加掛反而會在每次互動開始時付一次圖層建立的成本（正是使用者最敏感的
     那一瞬間）。代價是常駐一份圖層記憶體，實測沒有造成問題。

     ⚠️ 縮放沒有被這條解決，只是變輕：scale 一變圖層內容本來就必須重新光柵化，
     will-change 只能讓瀏覽器先 GPU 拉伸再補畫。要把縮放也推到 100 FPS 得做
     「停止縮放後才重新光柵化」，代價是縮放過程中畫面會糊——那是獨立的一件事。 */
  #viewport {
    will-change: transform;
  }

  /*
   * 標籤升成合成層——**只在有滑鼠的裝置**。2026-08-21 真機 A/B 實測定案。
   *
   * 關掉投影之後，畫布剩下的光柵化成本有八成壓在標籤上：畫面上實際渲染的 47 個 `<text>`
   * （骰子 41＋支援 5＋樹心 1，其餘符文／被動的標籤是 display:none，見下方「標籤擁擠」
   * 那段），每個約 0.25ms，而 239 個 pattern 填充的節點＋248 條邊加起來才 2.9ms。實測換成
   * 等長英數一樣慢，所以不是 CJK 的問題，是 SVG `<text>` 在 transform 變動時每一幀都要
   * 重新光柵化。升成合成層之後平移就退化成 GPU 位移，不再重畫。
   *
   *                     164Hz 桌機（有滑鼠）      60Hz 手機 dpr3.25
   *   不升層             平移掉 62 幀／縮放 41     平移掉 18 幀／縮放 40
   *   標籤升層           平移掉  0 幀／縮放 83     平移掉  0 幀／縮放 20 ←
   *
   * ⚠️ **手機一律不套，而且不是只為了那個縮放數字。** Android Chrome 上只要標籤升成合成層，
   *   骰子樹就會在平移／縮放時**閃爍**——常駐會閃，改成只在手勢期間加上、手勢結束拿掉
   *   （試過那一版）也會閃，因為 47 個標籤要從 `#viewport` 那張合成層切出去再併回來，
   *   兩端各得重畫一次整棵樹。桌機兩種寫法都不閃。既然常駐與否在手機上都不行、而在桌機上
   *   常駐又比隨手勢進出更快（縮放 83 vs 41，因為縮放期間圖層還在），結論就是這條：
   *   有滑鼠就常駐，沒滑鼠就完全不碰。
   *
   * 判準用 `(hover: hover) and (pointer: fine)` 而不是畫面寬度：會閃的是行動裝置的合成器，
   * 跟視窗多寬無關——桌機視窗拉窄不該失去這個優化，而寬螢幕的 Android 平板該被排除。
   *
   * 另外評估過、都否決掉的：手勢期間隱藏標籤（縮放時字消失太突兀，E2E 的 Z9 有擋）、
   * 把邊線也升層（手機縮放掉到 10 FPS）、把邊線與標籤烘成點陣圖（邊線只佔 11%，
   * 烘標籤則要處理篩選淡出、前置鏈高亮、放大變糊與重烘時機，代價遠大於這條 CSS）。
   */
  @media (hover: hover) and (pointer: fine) {
    #viewport text {
      will-change: transform;
    }
  }

  /* #tree-controls：#toolbar 與 #branch-nav 共用的 fixed 定位容器，用 flex column
     直向排列，讓 #branch-nav 自然接在 #toolbar「實際渲染高度」之後——不管 #toolbar
     的 flex-wrap 在窄視窗換成幾行，#branch-nav 都不會被蓋到（修 bug：舊版兩者各自
     寫死 top: 3rem / top: 6rem，後者假設前者恆為 3rem 高，視窗一窄就重疊）。
     align-items: flex-start 避免直向 flex 預設的 stretch 把 #branch-nav 的按鈕拉寬
     到跟 #toolbar 一樣寬。用 fixed 疊在畫布左上角（跟 #detail 疊在右側同一種做法），
     不佔版面、不必重算 #canvas-host 的 calc(100vh - 110px)。

     top: var(--nav-h, 3rem) 是第三次修同一類 bug（前兩次：#branch-nav 寫死
     top: 6rem 假設 #toolbar 恆 3rem 高；這次是 #tree-controls 本身寫死 top: 3rem
     假設全站導覽列 nav 恆 48px 高，但 nav 實際渲染高度是 padding 0.75rem×2 ＋ 行高
     ＋ 1px 下框線，量出來約 50.59px，2.59px 的落差讓 #toolbar 右上角的
     border-right 往上戳出 nav 下緣）。這次不換一個新的寫死數字，改成
     src/scripts/tree-canvas.ts 的 updateNavHeight() 在載入與 resize 時實測
     #site-nav 的 getBoundingClientRect().bottom，寫進 :root 的 --nav-h 自訂屬性；
     3rem 只當 JS 執行前的 fallback。#detail 面板（src/styles/global.css）用同一個
     變數，兩者高度基準永遠一致。 */
  #tree-controls {
    position: fixed;
    top: var(--nav-h, 3rem);
    left: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* 重要：#tree-controls 是 flex column，自身的盒子會撐到最寬子元素（#toolbar）的
       寬度，即使 #branch-nav 只佔左側一小條、右邊大片是視覺上的透明空白。這片空白如果
       沒有 pointer-events: none，會蓋住底下畫布，讓那個區域裡的節點完全點不到（E2E
       「點選節點會高亮前置鏈並顯示成本」在改用共用容器後就是死在這裡：Playwright
       回報 #tree-controls intercepts pointer events）。真正該接住點擊的是下面兩個
       有實際背景/內容的子元素，各自加回 pointer-events: auto 蓋掉繼承來的 none。 */
    pointer-events: none;
  }

  #toolbar {
    pointer-events: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
    border-right: 1px solid var(--border);
    border-bottom-right-radius: 8px;
  }

  #search {
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.35rem 0.6rem;
    min-width: 14rem;
    font: inherit;
  }

  #filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  #filters fieldset {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
  }

  /* legend 預設會被瀏覽器排在 fieldset 內容框的「上方那一格」，把底下的 checkbox 整列往下
     推——結果是工具列裡的搜尋框中線與 checkbox 中線差了 9px，看起來沒對齊。float 讓 legend
     退出那個特殊排版、變成一般的浮動盒子，標題就跟 checkbox 同一列，整條工具列共用一條中線。
     用 float 而不是 position:absolute：後者要自己算偏移量，而這個 repo 的固定偏移量已經咬過
     三次（見 CLAUDE.md）。 */
  #filters legend {
    float: left;
    color: var(--muted);
    font-size: 0.75rem;
    padding: 0 0.5rem 0 0;
  }

  #filter-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
    white-space: nowrap;
  }
  #filter-status[hidden] {
    display: none;
  }
  #filter-count.none {
    color: var(--gold);
  }
  #filter-clear {
    background: var(--panel);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
  }

  #filters label {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  /* 以下樣式作用在 tree-canvas.ts 用 DOM API 動態產生的節點／邊上，
     Astro 的 scoped CSS 只會標記本檔案模板裡「寫死」的元素，動態產生的 SVG 碰不到，
     所以這裡一律用 is:global。 */
  /* 邊的顏色、粗細與端點畫法都取自遊戲原圖的 `.edge` 規則（stroke:#a89ad3、寬 3.2、
     round 端點、opacity .9），讓站台跟原圖看起來是同一張圖。 */
  .edge {
    stroke: #a89ad3;
    stroke-width: 3.2;
    stroke-linecap: round;
    opacity: 0.9;
    fill: none;
  }

  .node {
    cursor: pointer;
  }

  /* 節點的投影。原圖是把它烘在圖片裡的（`#node-shadow` 濾鏡 ＋ `.dice-shadow` 剪影），
     但那樣會讓圖示的框比看得見的底板大一圈，鍵盤 focus 的外框與前置鏈的金色光暈就會去描
     那一圈空白（image8 回報）。改成在這裡用 CSS 畫：框剛好等於底板，投影還在，而且會跟著
     縮放一起變化，不會放大後糊成一塊貼圖。數值換算自原圖的
     `feDropShadow dx=0 dy=2 stdDeviation=2.2 flood-opacity=.48`（那組值在 scale(0.72)
     的座標系裡，再乘上站台的 0.5 倍座標）。 */
  /* ⚠️ 只在 `#tree.shadows` 下才畫，那個 class 由 tree-canvas.ts 的 `updateShadows()`
     依**骰子圖示目前的 CSS 顯示寬度**切換，門檻與遲滯是 `SHADOW_ON_AT_ICON_PX` /
     `SHADOW_OFF_AT_ICON_PX`（見 src/lib/viewport.ts，那裡也寫了為什麼刻意**不**沿用
     高解析圖示那組裝置像素門檻——兩者問的不是同一個問題）。

     這是效能修正，不是外觀取捨。239 個 drop-shadow 各自是一次離屏 filter pass，
     2026-08-21 用單檔 A/B 測試頁在真機上實測（同一份 DOM、同一組合成層設定，只切這條
     規則）：

       Android Chrome 手機 60Hz　平移 20→40 FPS、縮放 15→40 FPS
       164Hz Windows 桌機　　　 平移 82→164 FPS、縮放 28→83 FPS

     縮小時關掉看不出來，因為 `0 1px 1.5px` 是**使用者單位**：全貌視角下每單位不到 0.6
     個裝置像素，投影換算後只有約 0.5px，本來就低於一個像素。同日的像素比對（隱藏文字
     以排除反鋸齒雜訊）顯示差異只落在節點邊緣一圈、最大色差 40/255。等縮放大到投影真的
     看得見時，畫面上也只剩十幾顆節點，239 個 filter 的成本自然不存在。 */
  #tree.shadows .node .icon {
    filter: drop-shadow(0 1px 1.5px rgb(10 7 18 / 48%));
  }

  /* 中央樞紐：放射線比一般的邊粗一點、亮一點，讓「五顆起手骰從樹心長出來」讀得出來；
     整組不吃 pointer-events，點下去要穿透到底下的畫布（拖曳平移），不要變成一個點得到
     卻沒有反應的死區。 */
  .tree-center {
    pointer-events: none;
  }

  /* 樞紐放射線：原圖用的是跟 .edge 同色、同粗，但不透明度更高（.96 vs .9）——差別只在
     「更實一點」，不是更粗。這裡照抄，不自己另外設計一組。 */
  .tree-center-link {
    stroke: #a89ad3;
    stroke-width: 3.2;
    stroke-linecap: round;
    opacity: 0.96;
  }

  .tree-center-label {
    font-size: 12px;
    font-weight: 700;
    fill: var(--fg);
    text-anchor: middle;
  }

  .node .label {
    font-size: 11px;
    fill: var(--fg);
    text-anchor: middle;
    pointer-events: none;
    /* 描邊當底：標籤被單獨叫出來時，底下可能壓著邊、圖示或別的節點，沒有這層外框會糊成
       一片。paint-order: stroke 讓描邊畫在字的下面，不會把筆畫本身吃掉。 */
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  /*
   * 標籤擁擠（2026-08-18 換版面後浮上檯面）：符文 123 個＋玩家被動 70 個，它們的標籤平均寬
   * 61 使用者單位、彼此最近距離卻只有 41——標籤比間距還寬 1.5 倍，全部同時顯示必然互相壓到
   * （實測 27 對重疊，把字級一路縮到 7px 也只降到 15 對，縮字級根本不是解法）。
   *
   * 改成：畫面上恆常只留骰子（41）與支援（5）這 46 個導覽錨點的標籤——它們間距夠寬，實測
   * 0 對重疊——符文與被動的標籤改成「要看哪個就叫哪個」：滑鼠移過去、鍵盤聚焦、或它被選進
   * 前置鏈時才單獨出現。
   *
   * 用純 CSS 而不是 JS：hover 與 focus 本來就是 CSS 的事，選取狀態也已經有 .in-chain
   * （tree-canvas.ts 的 select() 掛的），不需要為了顯示標籤再養一套平行的狀態。
   *
   * 選擇器要寫死 :not(...) 兩層是為了讓「顯示」那組的優先級贏過「隱藏」那組——CSS 不看規則
   * 先後，只比優先級，少一層 :not() 就會被隱藏規則蓋回去。
   */
  .node:not([data-type='dice']):not([data-type='support']) .label {
    display: none;
  }
  .node:not([data-type='dice']):not([data-type='support']):hover .label,
  .node:not([data-type='dice']):not([data-type='support']):focus .label,
  .node:not([data-type='dice']):not([data-type='support']).in-chain .label {
    display: block;
  }

  /* 鍵盤 focus 的外框套在圖示那個 <rect> 上，不是整個 <g>：<g> 的框會把底下的標籤文字
     一起圈進去，框出來是一個又寬又高、下緣拖著一截字的方塊（image6 回報）。圖示的 rect
     自己的 x/y/width/height 就是節點的顯示範圍，框它才貼合按鈕本身。 */
  .node:focus {
    outline: none;
  }
  /* 外框是一圈貼著圖示輪廓的金邊，由 #focus-ring 濾鏡產生（定義見 src/lib/render.ts）：
     圓形節點得到圓環、圓角方塊得到圓角框。CSS 的 outline 做不到——它畫的永遠是矩形邊界框。
     投影要一起寫進來：filter 是單一屬性，只寫 url(#focus-ring) 會把 .node .icon 那條
     投影整條蓋掉，focus 的瞬間節點會突然變扁。 */
  /* ⚠️ 投影拆成兩條規則，順序與權重都不能動：`#tree.shadows .node .icon` 的權重是
     (1,3,0)，比 `.node:focus .icon` 的 (0,3,0) 高——只寫一條 focus 規則的話，
     shadows 模式下被 focus 的節點會被上面那條蓋掉，變成「只有投影、沒有金邊」。
     下面這條 `#tree.shadows .node:focus .icon` 是 (1,4,0)，權重最高，兩個模式都對。
     focus 外框是無障礙功能，**任何縮放下都必須在**，不跟著 `.shadows` 開關（同時最多只有
     一個節點被 focus，那一個 filter 沒有效能問題）。E2E 的 Z8 兩個模式各驗一次。 */
  .node:focus .icon {
    filter: url(#focus-ring);
  }
  #tree.shadows .node:focus .icon {
    filter: url(#focus-ring) drop-shadow(0 1px 1.5px rgb(10 7 18 / 48%));
  }

  /* Windows 高對比模式會把 filter 產生的顏色整個抽掉，focus 指示就消失了。那個模式下改用
     老派的矩形 outline——不夠貼合，但「看得見焦點在哪」優先於「框得好不好看」。 */
  @media (forced-colors: active) {
    /* 兩個選擇器都要列：只寫 `.node:focus .icon` (0,3,0) 的話，shadows 模式下會被上面
       的 `#tree.shadows .node:focus .icon` (1,4,0) 用權重蓋過去，高對比模式就失效了。
       列出的第二條權重跟它相同，靠「後出現者勝」拿下（這個區塊在原始碼裡排在後面）。 */
    .node:focus .icon,
    #tree.shadows .node:focus .icon {
      filter: none;
      outline: 2px solid;
      outline-offset: 0;
    }
  }

  /* 桌機側欄的分支快速跳轉（spec §6.2.6）：跟在 #toolbar 下面、直向排列（定位交給
     #tree-controls，見上面該規則的註解）。手機版改用畫面底部的 #branch-chips（見下面
     的手機媒體查詢），兩者互斥顯示、共用同一組 data-branch 按鈕與同一個
     tree-canvas.ts 的 jumpToBranch() handler。 */
  #branch-nav {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    /* 左右內距要跟 #toolbar 一樣是 1rem：兩者上下相接、同屬畫布左上角那一疊，左內距不一樣
       的話按鈕會比上面的搜尋框往左凸出 8px（2026-08-18 人工檢視回報）。改動時兩邊一起改。 */
    padding: 0.5rem 1rem;
  }
  #branch-nav button {
    background: var(--panel);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.35rem 0.6rem;
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    white-space: nowrap;
  }
  #branch-nav button:hover {
    border-color: var(--gold);
  }

  /* 手機版分支切換列：預設（桌機寬度）不顯示，下面的手機媒體查詢會改成固定在畫面底部的
     橫向列。DOM 結構（#branch-chips 內 5 個 button[data-branch]）是跨任務契約，
     不要改名，見上方模板註解與 task-17 brief。 */
  #branch-chips {
    display: none;
  }
  #branch-chips button {
    background: var(--panel);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.4rem 0.6rem;
    font: inherit;
    font-size: 0.8rem;
  }

  /* #filters-toggle 只在手機版顯示（見下面媒體查詢）；桌機版 #filters 常駐展開，
     不需要這顆開關。 */
  #filters-toggle {
    display: none;
    background: var(--panel);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.35rem 0.6rem;
    font: inherit;
  }

  /* 手機版視角（task-17）：底部分支 chip、詳情面板改由下方滑出、篩選收進頂部抽屜、
     桌機側欄跳轉按鈕隱藏（手機版用底部 chip 取代）。斷點 720px 要跟
     src/scripts/tree-canvas.ts 判斷 isMobile 用的 matchMedia 查詢字串保持一致，
     兩邊改動時要一起改。 */
  @media (max-width: 720px) {
    #filters-toggle {
      display: inline-block;
    }
    #branch-nav {
      display: none;
    }
    #detail {
      position: fixed;
      /* 手機維持「從底部升起的抽屜」，不套桌機那組浮動卡片的樣式：窄螢幕上把卡片再往內縮
         0.75rem 只會讓本來就不夠的寬度更擠。inset 會一次覆蓋桌機設的 top/right，但圓角、
         陰影與四邊框線不會，要各自歸零，否則抽屜會變成一張貼在螢幕下緣、只有上面兩角是
         圓的怪卡片。 */
      /* 底緣停在 #branch-chips 上方，而不是壓到螢幕最底下再靠內距補救——高度由
         tree-canvas.ts 量出來寫進 --chips-h，不是又一個寫死的偏移量。 */
      inset: auto 0 var(--chips-h, 3.5rem) 0;
      width: 100%;
      max-width: 100%;
      max-height: 55vh;
      border: none;
      border-top: 1px solid var(--border);
      border-radius: 0;
      box-shadow: none;
      /* ⚠️ 這裡曾經是 `bottom: 0` ＋ `padding-bottom: 4.5rem`：讓抽屜壓到螢幕最底下，
         再靠內距把「重置需要初期化券」那段災情警告（spec §2.1 強制要求，永遠是 #detail
         的最後一段）推到 #branch-chips 上緣之上。

         那個做法只在「使用者已經捲到底」時成立。面板一變長（2026-08-19 加了關鍵字解釋、
         骰子覺醒、練滿花費三段），內容超出 max-height 而 scrollTop 還是 0，警告就落在
         可視區的下緣——也就是 chip 列正下方——實測 warn 798–839 對上 chips 786.75 起。
         padding-bottom 完全沒被用到，因為它在捲動內容的「結尾」，而使用者根本還沒捲到那裡。

         現在改成讓抽屜的**可視方框**就停在 chip 列上方（`bottom: var(--chips-h)`）：
         不管捲到哪裡，面板裡的任何一個像素都不會落進 chip 列。這也是 CLAUDE.md 那條
         「不要再引入新的固定偏移量」的同一個教訓——量出來的值，不是猜出來的值。 */
    }
    /* 手機版篩選抽屜：**留在 #toolbar 的正常流程裡**，收起就不存在、展開就接在工具列下面。
       不用 position:fixed，也不用任何位移量。

       舊版是 `position: fixed; top: 0` 收起、`transform: translateY(var(--nav-h))` 展開——
       跟 #tree-controls 的 `top: var(--nav-h)` 用同一個基準，於是展開後抽屜**從工具列頭上
       開始蓋**，把搜尋框和 #filters-toggle 自己都蓋住（實測 Pixel 7：抽屜 50.59–119.66、
       切換鈕 58.59–97.38，elementFromPoint(切換鈕中心) 回傳 FIELDSET）。開了就關不掉，
       唯一的出路是重新整理。用同一個變數並不能救——兩者本來就該是上下相接，不是同一個起點。

       `display: none` 一併解掉另一個問題：收起狀態的 checkbox 以前仍然可以 Tab 聚焦、
       螢幕閱讀器也仍然唸得到一個看不見的表單。 */
    #filters {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
    }
    #filters.open {
      display: flex;
    }
    /* footer 讓位給 chip 列：#branch-chips 是 fixed bottom:0，頁面改成不捲動之後它會永遠
       疊在 footer 上緣，而 footer 第二行是「著作權屬 111 Percent Inc.」這句必須看得到的
       聲明——手機上完全讀不到。--chips-h 由 tree-canvas.ts 量實際高度寫入（不寫死數字，
       這個 repo 的固定偏移量已經咬過五次）。<main> 是 flex: 1，footer 變高只會讓畫布跟著
       縮，不會把捲軸叫回來。 */
    body:has(#canvas-host) footer {
      padding-bottom: calc(1rem + var(--chips-h, 3.5rem));
    }
    #branch-chips {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      display: flex;
      justify-content: space-around;
      background: var(--panel);
      padding: 0.5rem;
      border-top: 1px solid var(--border);
      z-index: 5;
    }
  }
</style>
