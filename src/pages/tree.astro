---
// 骰子樹畫布頁：239 個節點、248 條邊的靜態結構 + 平移縮放（滑鼠/雙指/鍵盤）+
// 選取/前置鏈高亮/詳情面板 + 搜尋/篩選/網址狀態同步。
// 掛載邏輯放在 src/scripts/tree-canvas.ts，方便各任務在同一支腳本上疊加互動。
import Base from '../layouts/Base.astro';
import '../styles/detail.css';
import '../styles/canvas.css';

// 分支（5 個，spec §6.3）與類型（4 個）在編譯期就是固定的字面聯集，不是要跑期才知道的
// 節點資料，所以直接在這裡的 frontmatter 迴圈產生 checkbox 標記（Astro 本來就是做這件事
// 的地方），不另外開一支 src/components/FilterBar.ts 純字串產生器——沒有需要在瀏覽器沒有
// 的環境下單獨單元測試的邏輯（不像 NodeDetail.ts 有 HTML escape、關鍵字白名單比對這些
// 值得鎖住的行為），見 task-16-report.md「FilterBar.ts 的取捨」一節。
// value 用的字串必須跟 src/lib/types.ts 的 Branch / NodeType 字面聯集完全對應，
// 因為 tree-canvas.ts 會直接把 dataset 值當 Branch/NodeType 塞進 FilterState。
const BRANCHES: Array<[string, string]> = [
  ['nature', '自然'],
  ['engineering', '工學'],
  ['magic', '魔法'],
  ['order', '秩序'],
  ['chaos', '渾沌'],
];
const TYPES: Array<[string, string]> = [
  ['dice', '骰子'],
  ['rune', '骰子符文'],
  ['passive', '玩家被動'],
  ['support', '支援'],
];
---

<Base title="骰子樹">
  <!-- #tree-controls：把 #toolbar 與 #branch-nav 包進同一個 position:fixed 的直向
       flex 容器（修 bug：舊版兩者各自用寫死的 top 值疊放，#branch-nav 的 top:6rem
       假設 #toolbar 永遠只有 3rem 高，但 #toolbar 有 flex-wrap，視窗變窄換行變高後
       #branch-nav 就會壓上去）。改成同一個 flex column 容器後，#branch-nav 永遠緊接
       在 #toolbar 實際渲染高度之後，不論 #toolbar 換幾行都不會重疊。#tree-controls
       本身不是既有 DOM 契約的一部分，純粹是版面用的包裝元素，tree-canvas.ts／E2E
       完全不吃這個 id，只吃裡面兩個原本就有的 id。 -->
  <div id="tree-controls">
    <div id="toolbar">
      <!-- 手機版才顯示（見下面 CSS）：篩選收進頂部抽屜，預設收起，點這顆按鈕展開/收起
           #filters（切 .open class，接線見 tree-canvas.ts）。桌機版 #filters 本來就常駐
           顯示，不需要這顆按鈕，靠 CSS 媒體查詢隱藏。 -->
      <button id="filters-toggle" type="button" aria-label="展開篩選" aria-controls="filters">篩選</button>
      <input id="search" type="search" placeholder="搜尋節點名稱、效果、關鍵字…" aria-label="搜尋節點" />
      <!--
        篩選結果的播報。看不見，但仍在無障礙樹裡（.sr-only 用 clip-path，不是 display:none）。
        2026-08-22 把工具列上那句「符合 N 個節點」拿掉之後，篩選結果就完全沒有東西告訴螢幕
        閱讀器使用者了——原本那個 <p role="status"> 是這一頁唯一的 live region。畫面上不顯示
        是 Yuki 指定的，播報則不該跟著消失，所以留一個純給輔助技術的版本。
      -->
      <p id="filter-live" class="sr-only" role="status" aria-live="polite"></p>
      <div id="filters">
        <!-- 用 <div role="group"> 而不是 <fieldset><legend>，理由見 dice.astro 的說明。 -->
        <div class="filter-group" role="group" aria-label="分支">
          <span class="filter-group-label" aria-hidden="true">分支</span>
          {BRANCHES.map(([value, label]) => (
            <label class="chip" data-branch={value}>
              <input type="checkbox" data-branch={value} />
              <span class={`branch-dot branch-${value}`} aria-hidden="true"></span>{label}
            </label>
          ))}
        </div>
        <div class="filter-group" role="group" aria-label="類型">
          <span class="filter-group-label" aria-hidden="true">類型</span>
          {TYPES.map(([value, label]) => (
            <label class="chip"><input type="checkbox" data-type={value} />{label}</label>
          ))}
        </div>
        <!-- 「清除篩選」住在面板裡，不在工具列上：它一出現就會改變工具列寬度，而工具列是
             浮在畫布上的，寬度一變整排東西跟著跳（2026-08-22 Yuki 回報）。面板收起時看不到
             它也沒關係——切換鈕上的金點會說現在有篩選在生效。 -->
        <button id="filter-clear" type="button" data-idle>清除篩選</button>
      </div>
    </div>
    <!-- 桌機側欄的分支快速跳轉（spec §6.2.6）：跟下面手機版 #branch-chips 是同一組分支、
         同一個按鈕點擊 handler（見 tree-canvas.ts 的 jumpToBranch()，不寫兩份跳轉邏輯），
         只是版面位置與顯示時機不同（CSS 媒體查詢互斥顯示）。 -->
    <nav id="branch-nav" aria-label="分支快速跳轉">
      {BRANCHES.map(([value, label]) => (
        <button type="button" data-branch={value}>{label}</button>
      ))}
    </nav>
  </div>
  <div id="canvas-host">
    <script>
      import '../scripts/tree-canvas.ts';
    </script>
  </div>
  <aside id="detail" hidden></aside>
  <!-- 手機版底部的分支切換列（DOM 契約，見 task-17 brief：#branch-chips 內含 5 個
       button[data-branch]，第 18 個任務的 E2E 已經寫死這個結構）。 -->
  <div id="branch-chips">
    {BRANCHES.map(([value, label]) => (
      <button type="button" data-branch={value}>{label}</button>
    ))}
  </div>
</Base>

<style is:global>
  /* ⚠️ 畫布頁的版面（body／main／#canvas-host／#tree／#viewport 升層）**在 src/styles/canvas.css**，
     不在這裡——`/sim` 用的是同一套骨架，複製第二份出去就一定漂移（CLAUDE.md 記過三次同一件事）。
     這個檔案只留 `/tree` 專屬的東西：工具列、篩選面板、詳情卡片、分支導覽。 */

  /* #tree-controls：#toolbar 與 #branch-nav 共用的 fixed 定位容器，用 flex column
     直向排列，讓 #branch-nav 自然接在 #toolbar「實際渲染高度」之後——不管 #toolbar
     的 flex-wrap 在窄視窗換成幾行，#branch-nav 都不會被蓋到（修 bug：舊版兩者各自
     寫死 top: 3rem / top: 6rem，後者假設前者恆為 3rem 高，視窗一窄就重疊）。
     align-items: flex-start 避免直向 flex 預設的 stretch 把 #branch-nav 的按鈕拉寬
     到跟 #toolbar 一樣寬。用 fixed 疊在畫布左上角（跟 #detail 疊在右側同一種做法），
     不佔版面、不必重算 #canvas-host 的 calc(100vh - 110px)。

     top: var(--nav-h, 3rem) 是第三次修同一類 bug（前兩次：#branch-nav 寫死
     top: 6rem 假設 #toolbar 恆 3rem 高；這次是 #tree-controls 本身寫死 top: 3rem
     假設全站導覽列 nav 恆 48px 高，但 nav 實際渲染高度是 padding 0.75rem×2 ＋ 行高
     ＋ 1px 下框線，量出來約 50.59px，2.59px 的落差讓 #toolbar 右上角的
     border-right 往上戳出 nav 下緣）。這次不換一個新的寫死數字，改成
     src/scripts/tree-canvas.ts 的 updateNavHeight() 在載入與 resize 時實測
     #site-nav 的 getBoundingClientRect().bottom，寫進 :root 的 --nav-h 自訂屬性；
     3rem 只當 JS 執行前的 fallback。#detail 面板（src/styles/detail.css）用同一個
     變數，兩者高度基準永遠一致。 */
  #tree-controls {
    position: fixed;
    top: var(--nav-h, 3rem);
    left: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* 重要：#tree-controls 是 flex column，自身的盒子會撐到最寬子元素（#toolbar）的
       寬度，即使 #branch-nav 只佔左側一小條、右邊大片是視覺上的透明空白。這片空白如果
       沒有 pointer-events: none，會蓋住底下畫布，讓那個區域裡的節點完全點不到（E2E
       「點選節點會高亮前置鏈並顯示成本」在改用共用容器後就是死在這裡：Playwright
       回報 #tree-controls intercepts pointer events）。真正該接住點擊的是下面兩個
       有實際背景/內容的子元素，各自加回 pointer-events: auto 蓋掉繼承來的 none。 */
    pointer-events: none;
  }

  #toolbar {
    pointer-events: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    border-right: 1px solid var(--border);
    border-bottom-right-radius: var(--r-md);
    /* 浮在畫布上的東西要有陰影，否則工具列跟底下的骰子樹只靠一條 1px 框線分開。 */
    box-shadow: var(--shadow-2);
  }

  #search {
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--r-xs);
    padding: var(--space-2) var(--space-3);
    min-width: 14rem;
    font: inherit;
  }

  /* 篩選面板預設收起，靠 .open 展開——桌機與手機同一套規則（2026-08-22）。
     以前只有手機收得起來，桌機的篩選鈕永遠攤在工具列上，佔掉畫布上方一整條。 */
  #filters {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  #filters.open {
    display: flex;
  }
  /* 收合的左右伸縮過場。只在動畫進行中掛，平常不留 transition／overflow：
     - `flex-wrap: nowrap`：寬度縮到 0 的過程中若還會換行，內容會先攤成好幾列、
       把工具列撐高一大塊再收掉，看起來像壞掉。動畫結束就解除，窄視窗照樣換行。
     - `overflow: hidden`：被擠出去的內容要裁掉，不能戳到工具列外面。
     寬度是 JS 量出來鎖成 px 的（見 tree-canvas.ts 的 setFiltersOpen），CSS 這裡只負責過場。 */
  #filters.animating,
  #filters.animating .filter-group {
    flex-wrap: nowrap;
  }
  #filters.animating {
    overflow: hidden;
    transition: width var(--t-med) var(--slide-ease);
  }
  @media (prefers-reduced-motion: reduce) {
    #filters.animating {
      transition: none;
    }
  }



  /* 沒有篩選時清除鈕留在原地但看不見。
     ⚠️ 用 visibility 而不是 display／hidden：它在面板的最後一格，用 display 收放會讓面板
     連帶工具列的寬度跟著篩選狀態伸縮——那正是 2026-08-22 要修掉的那個症狀，只是換個地方
     復發（實測展開 1121px、一有篩選就變 1215px）。
     visibility: hidden 依規範就不可聚焦、也收不到指標事件，不必另外停用。 */
  #filter-clear[data-idle] {
    visibility: hidden;
  }
  #filter-clear {
    /* 「清除篩選」不准折行也不准被壓縮。收合的過場會把容器寬度一路壓到 0，它一被壓縮就折成
       四行，面板高度從 35 變 90，整條工具列在動畫過程中先長高一倍再收掉（2026-08-22 逐幀
       量到）。窄視窗下工具列換行、這一列變擠時也是同一回事。E2E 的 O4 守這條。 */
    flex: none;
    white-space: nowrap;
    background: var(--surface-2);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--r-xs);
    padding: var(--space-1) var(--space-2);
    font: inherit;
    font-size: var(--fs-xs);
    cursor: pointer;
  }

  /* 這裡刻意不再定義 #filters label：它現在是 .chip，樣式全部來自 components.css。
     留一條 id 具體度的規則在這裡的話，會把共用樣式蓋掉一半，兩頁的篩選器又長得不一樣。 */

  /* ⚠️ 節點／邊／標籤／focus 外框的樣式**在 src/styles/canvas.css**（「畫布內容」那一節），
     不在這裡——`/sim` 畫的是同一份 renderTree() 產物，兩頁共用一份。
     2026-08-23 搬過去時抓到一個真 bug：`/sim` 完全沒有 `.node .label` 的樣式，標籤吃 SVG
     預設的 16px（使用者座標），**別的節點的標籤蓋住了 10 顆節點的圖示中心**，點下去打到的
     是那個標籤所屬的節點。症狀是「點某幾顆完全沒反應」。
     ⚠️ 反例測過：真正擋住這件事的是**字級**（`--fs-xs`）——單獨拿掉 `pointer-events: none`
     或讓符文標籤全部顯示，`tests/e2e/sim.spec.ts` 的 S13 都不會紅，把字級改回 16px 才紅
     （而且一次紅 10 對）。 */

  /* 桌機側欄的分支快速跳轉（spec §6.2.6）：跟在 #toolbar 下面、直向排列（定位交給
     #tree-controls，見上面該規則的註解）。手機版改用畫面底部的 #branch-chips（見下面
     的手機媒體查詢），兩者互斥顯示、共用同一組 data-branch 按鈕與同一個
     tree-canvas.ts 的 jumpToBranch() handler。 */
  #branch-nav {
    pointer-events: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    /* 左右內距要跟 #toolbar 一樣是 1rem：兩者上下相接、同屬畫布左上角那一疊，左內距不一樣
       的話按鈕會比上面的搜尋框往左凸出 8px（2026-08-18 人工檢視回報）。改動時兩邊一起改。 */
    padding: var(--space-2) var(--space-4);
  }
  #branch-nav button {
    background: var(--surface-2);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--r-xs);
    padding: var(--space-2) var(--space-3);
    font: inherit;
    font-size: var(--fs-xs);
    cursor: pointer;
    white-space: nowrap;
  }
  #branch-nav button:hover {
    background: var(--surface-3);
    border-color: var(--gold);
  }

  /* 手機版分支切換列：預設（桌機寬度）不顯示，下面的手機媒體查詢會改成固定在畫面底部的
     橫向列。DOM 結構（#branch-chips 內 5 個 button[data-branch]）是跨任務契約，
     不要改名，見上方模板註解與 task-17 brief。 */
  #branch-chips {
    display: none;
  }
  #branch-chips button {
    background: var(--surface-2);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--r-xs);
    padding: var(--space-2) var(--space-3);
    font: inherit;
    font-size: var(--fs-xs);
  }

  /* 展開／收起篩選面板。2026-08-22 起桌機也有這顆（以前只在手機版顯示，桌機的篩選鈕常駐
     攤在工具列上）。 */
  #filters-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--surface-2);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--r-xs);
    padding: var(--space-2) var(--space-3);
    font: inherit;
    cursor: pointer;
  }
  #filters-toggle:hover {
    border-color: var(--border-strong);
  }
  /* 展開狀態：箭頭轉向。選擇器綁 aria-expanded，樣式與無障礙狀態不會各講各的。
     桌機的面板是往右邊長出來的，所以箭頭是左右向（▸ 收起／◂ 展開），不是上下。
     手機版是往下掉的抽屜，下面的媒體查詢換回 ▾。 */
  #filters-toggle::after {
    content: '▸';
    color: var(--muted);
    font-size: var(--fs-xs);
    transition: transform var(--t-fast) ease;
  }
  #filters-toggle[aria-expanded='true']::after {
    transform: rotate(180deg);
  }
  /* 有篩選在生效時點一顆金點。用固定尺寸的圓點而不是「篩選 (2)」這種文字：文字會改變按鈕
     寬度，工具列又會開始跳。面板收起時這是唯一的線索，不能省。
     ⚠️ 圓點**一直都在**，只是平常透明——只在 .active 時才長出來的話，按鈕會寬 16px
     （圓點 8px ＋ gap 8px），工具列與整排篩選鈕又會跟著篩選狀態左右移動（實測 1199→1215）。 */
  #filters-toggle::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--r-pill);
    background: transparent;
    transition: background-color var(--t-fast) ease;
  }
  #filters-toggle.active {
    border-color: var(--gold);
  }
  #filters-toggle.active::before {
    background: var(--gold);
  }
  /* 零命中：金點轉成警示色。畫布這時會淡成一片灰，這是唯一不動到工具列尺寸的提示方式。 */
  #filters-toggle.active.none {
    border-color: var(--nature);
  }
  #filters-toggle.active.none::before {
    background: var(--nature);
  }

  /* 手機版視角（task-17）：底部分支 chip、詳情面板改由下方滑出、篩選收進頂部抽屜、
     桌機側欄跳轉按鈕隱藏（手機版用底部 chip 取代）。斷點 720px 要跟
     src/scripts/tree-canvas.ts 判斷 isMobile 用的 matchMedia 查詢字串保持一致，
     兩邊改動時要一起改。 */
  @media (max-width: 720px) {
    #branch-nav {
      display: none;
    }
    #detail {
      position: fixed;
      /* 手機維持「從底部升起的抽屜」，不套桌機那組浮動卡片的樣式：窄螢幕上把卡片再往內縮
         0.75rem 只會讓本來就不夠的寬度更擠。inset 會一次覆蓋桌機設的 top/right，但圓角、
         陰影與四邊框線不會，要各自歸零，否則抽屜會變成一張貼在螢幕下緣、只有上面兩角是
         圓的怪卡片。 */
      /* 底緣停在 #branch-chips 上方，而不是壓到螢幕最底下再靠內距補救——高度由
         tree-canvas.ts 量出來寫進 --chips-h，不是又一個寫死的偏移量。 */
      inset: auto 0 var(--chips-h, 3.5rem) 0;
      width: 100%;
      max-width: 100%;
      max-height: 55vh;
      /* 桌機卡片 2026-08-23 縮了一級（寬 18rem、內距 --space-3、字級 --fs-md），
         那是為了「浮在節點正上方時不要壓迫」。手機抽屜是全寬、貼在螢幕底部，沒有那個
         問題，字再縮只會更難讀——這裡還原成原本的內距與字級。 */
      padding: var(--space-4);
      font-size: var(--fs-base);
      border: none;
      border-top: 1px solid var(--border);
      border-radius: 0;
      box-shadow: none;
      /* ⚠️ 這裡曾經是 `bottom: 0` ＋ `padding-bottom: 4.5rem`：讓抽屜壓到螢幕最底下，
         再靠內距把「重置需要初期化券」那段災情警告（spec §2.1 強制要求，永遠是 #detail
