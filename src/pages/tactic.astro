---
// 靜態玩家文本留在 HTML；候選池、階段篩選只切換可見性。
import Base from '../layouts/Base.astro';
import '../styles/battle.css';
import tacticsRaw from '../../data/tactics.json';
import keywordsRaw from '../../data/keywords.json';
import { treeData } from '../lib/tree-data';
import { buildGlossary, displayGlossary } from '../lib/glossary-groups';
import { renderStaticText } from '../lib/static-markup';
import { DEFAULT_TACTIC_MODE, TACTIC_MODES, TACTIC_STAGES, tacticMatches } from '../lib/tactics';
import type { GlossaryRecord, Tactic, TreeData } from '../lib/types';

const tactics = tacticsRaw as Tactic[];
const keywords = keywordsRaw as Record<string, GlossaryRecord>;
const tree = treeData as unknown as TreeData;
const index = buildGlossary(keywords, tree.nodes);
const glossary = displayGlossary(keywords);
const whitelist = Object.keys(keywords);
const initialCount = tactics.filter(t => tacticMatches(t, DEFAULT_TACTIC_MODE, TACTIC_STAGES)).length;
---

<Base title="戰術">
  <section class="page battle-page" id="tactic-page" data-mode={DEFAULT_TACTIC_MODE}>
    <h1 class="page-head">戰術</h1>
    <p class="lede">對戰與合作模式中的戰術效果。</p>

    <div class="filter-bar" id="tactic-filters">
      <div class="filter-group" role="radiogroup" aria-label="選擇模式">
        {TACTIC_MODES.map(mode => (
          <label class="chip">
            <input type="radio" name="tactic-mode" value={mode.key} checked={mode.key === DEFAULT_TACTIC_MODE} />
            {mode.label}
          </label>
        ))}
      </div>
      <div class="filter-group" role="group" aria-label="依階段篩選">
        <button type="button" id="tactic-all" class="chip" data-active aria-pressed="true">全部</button>
        {TACTIC_STAGES.map(stage => (
          <label class="chip">
            <input type="checkbox" name="stage" value={stage} checked />
            {stage}
          </label>
        ))}
      </div>
      <span class="filter-count" aria-live="polite">
        顯示 <span id="tactic-count">{initialCount}</span> / {tactics.length}
      </span>
    </div>

    <ul class="battle-list" id="tactic-list">
      {tactics.map(t => (
        <li
          class="battle-item row-card"
          id={`t${t.id}`}
          data-id={t.id}
          data-stage={t.stage}
          data-versus={String(t.availability.versus)}
          data-coop-normal={String(t.availability.coopNormal)}
          data-coop-hard={String(t.availability.coopHard)}
          hidden={!t.availability[DEFAULT_TACTIC_MODE]}
        >
          <img class="battle-icon" src={`/assets/tactic-icons/${t.icon}.webp`} alt="" loading="lazy" decoding="async" />
          <div class="tactic-content">
            <div class="battle-head">
              <h2 class="battle-name">{t.name}</h2>
              <span class="battle-meta"><span class="battle-tag">{t.stage}</span></span>
            </div>
            {t.versus && <p class="battle-text" data-mode="versus" set:html={renderStaticText(t.versus, whitelist, glossary, index)} />}
            {t.coop && <p class="battle-text" data-mode="coop" set:html={renderStaticText(t.coop, whitelist, glossary, index)} />}
            {t.options && (
              <details class="tactic-options">
                <summary>查看 {t.options.length} 個選項</summary>
                <ul class="battle-list">
                  {t.options.map(option => (
                    <li class="battle-item row-card" id={`t${option.id}`}>
                      <img class="battle-icon" src={`/assets/tactic-icons/${option.icon}.webp`} alt="" loading="lazy" decoding="async" />
                      <div class="tactic-content">
                        <h3 class="battle-name">{option.name}</h3>
                        <p class="battle-text" set:html={renderStaticText(option.text, whitelist, glossary, index)} />
                      </div>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </div>
        </li>
      ))}
    </ul>
    <p class="battle-empty" id="tactic-empty" hidden>目前的篩選條件沒有符合的戰術。</p>
  </section>
</Base>

<script>
  import { DEFAULT_TACTIC_MODE, TACTIC_STAGES, tacticMatches, toggleAllTacticStages } from '../lib/tactics';
  import type { Tactic, TacticMode } from '../lib/types';

  const page = document.getElementById('tactic-page');
  const filters = document.getElementById('tactic-filters');
  const list = document.getElementById('tactic-list');
  const count = document.getElementById('tactic-count');
  const empty = document.getElementById('tactic-empty');
  const all = document.getElementById('tactic-all');

  if (page && filters && list && count && empty) {
    const boxes = [...filters.querySelectorAll<HTMLInputElement>('input[name=stage]')];
    const modes = [...filters.querySelectorAll<HTMLInputElement>('input[name=tactic-mode]')];
    // 只計父戰術；巢狀子項自然跟隨父卡，不算獨立階段／筆數。
    const items = [...list.querySelectorAll<HTMLElement>(':scope > .battle-item')];
    const selectedStages = () => boxes.filter(box => box.checked).map(box => box.value);
    const apply = () => {
      const mode = (modes.find(input => input.checked)?.value ?? DEFAULT_TACTIC_MODE) as TacticMode;
      const stages = selectedStages();
      page.dataset.mode = mode;
      let shown = 0;
      for (const item of items) {
        const tactic = {
          stage: item.dataset.stage,
          availability: {
            versus: item.dataset.versus === 'true',
            coopNormal: item.dataset.coopNormal === 'true',
            coopHard: item.dataset.coopHard === 'true',
          },
        } as Pick<Tactic, 'stage' | 'availability'>;
        item.hidden = !tacticMatches(tactic, mode, stages);
        if (!item.hidden) shown++;
      }
      count.textContent = String(shown);
      empty.hidden = shown > 0;
      const allSelected = TACTIC_STAGES.every(stage => stages.includes(stage));
      all?.toggleAttribute('data-active', allSelected);
      all?.setAttribute('aria-pressed', String(allSelected));
    };
    filters.addEventListener('change', apply);
    all?.addEventListener('click', () => {
      const next = toggleAllTacticStages(selectedStages());
      for (const box of boxes) box.checked = next.includes(box.value as typeof next[number]);
      apply();
    });
    apply();
  }
</script>
