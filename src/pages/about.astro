---
// 貢獻頁：正本只有 repo 根目錄的 CONTRIBUTING.md 一份，避免網站文字與檔案內容日後各自漂移。
// 用 Astro 內建的 Markdown 匯入（.md 檔可直接 import 取得 <Content />）渲染成排版後的
// HTML，不需要額外安裝 Markdown 解析套件。
import Base from '../layouts/Base.astro';
import { Content } from '../../CONTRIBUTING.md';
---

<Base title="貢獻">
  <article class="contributing">
    <Content />
  </article>
</Base>

<style>
  .contributing {
    padding: var(--space-6);
    max-width: 52rem;
    margin: 0 auto;
  }
  .contributing :global(h1) {
    font-size: var(--fs-3xl);
    margin-top: 0;
  }
  .contributing :global(h2) {
    font-size: var(--fs-xl);
    margin-top: var(--space-6);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }
  .contributing :global(ul),
  .contributing :global(ol) {
    padding-left: var(--space-5);
  }
  .contributing :global(li) {
    margin: var(--space-2) 0;
  }
  .contributing :global(code) {
    background: var(--surface-1);
    padding: 0.1em 0.35em;
    border-radius: 0.25em;
    font-size: 0.9em;
  }
  .contributing :global(pre) {
    background: var(--surface-1);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--r-md);
    overflow-x: auto;
  }
  .contributing :global(pre code) {
    background: none;
    padding: 0;
  }
  .contributing :global(a) {
    word-break: break-word;
  }
</style>
