---
import RewardGrantView from './RewardGrant.astro';
import { rewardDisplay } from '../lib/reward-display';
import type { RewardReferenceSection } from '../lib/types';
import { langFromPath, messages } from '../lib/i18n';
interface Props { section: RewardReferenceSection; showNote?: boolean; card?: boolean; sectionTitle?: boolean }
const { section, showNote = true, card = false, sectionTitle = false } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const rw = messages(lang).rewardsPage;
---
<section class="reward-reference-section" data-repeatable-section={section.id} aria-labelledby={`reward-reference-${section.id}`}>
  <div class="reward-reference-heading">
    <h3 class:list={{ 'sec-title': sectionTitle }} id={`reward-reference-${section.id}`}>{section.title}</h3>
  </div>
  <div class:list={{ 'reward-reference-card': card, panel: card }}>
  {showNote && section.note && <p class="reward-achievement-note">{section.note}</p>}
  <div class:list={['reward-list-head', 'reward-reference-row', { 'reward-reference-with-icon': section.tierImages }]} aria-hidden="true">
    {section.tierImages && <span>{rw.streakIcon}</span>}
    <span>{section.metricLabel}</span><span>{rw.rewardContent}</span>
  </div>
  <ol class="reward-list reward-milestone-list" aria-label={rw.sectionRewards(section.title)}>
    {section.tiers.map(tier => (
      <li class:list={['reward-tier', 'row-card', 'reward-reference-row', { 'reward-reference-with-icon': section.tierImages }]} data-repeatable-tier>
        {section.tierImages && <img class="reward-reference-image" src={section.tierImages[tier.requirement]!.src}
          alt={section.tierImages[tier.requirement]!.alt} width={section.tierImages[tier.requirement]!.width}
          height={section.tierImages[tier.requirement]!.height} />}
        <strong class="reward-requirement">{tier.requirement.toLocaleString('en-US')}</strong>
        <ul class="reward-grants" aria-label={rw.rewardContent}>
          {tier.rewards.map(reward => (
            <li aria-label={`${rewardDisplay(reward, lang).label} ${reward.amount.toLocaleString('en-US')}`}>
              <RewardGrantView reward={reward} amount={reward.amount} />
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
  </div>
</section>
