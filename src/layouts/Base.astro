---
// 全站共用版面：導覽列、頁尾版權聲明。
// 導覽列只放已上線的頁面。「貢獻」入口目前由 src/lib/flags.ts 的 FEATURES.contributeLink
// 暫時關掉（頁面本身還在，只是不從導覽列曝光）。
// ⚠️ 這五行的順序就是層疊順序，是刻意選的分層（token → 全站基底 → 導覽列 → 內容頁 → 元件），
// 不是舊 `global.css`（2026-08-26 已拆散）原始區段順序的重現——原檔是交錯的（例如
// `#site-nav` 的下拉區塊原本排在 `#hit-counter`／`.branch-dot` 之後，`.kw-*` 區塊原本排在
// `.chip`／`.dice-card` 之後），拆檔時把交錯的區段各自合併進所屬的檔案，跨檔的相對順序因此
// 必然改變。順序本身沒問題，靠的是「沒有跨檔的同具體度衝突」這個事實（已用
// `tools/compare-computed.ts` 的 0 差異與靜態掃描雙重確認），不要調換。
// 另外四個檔（detail／canvas／dice／board）由用得到的頁面自己 import，
// 而且必須寫在該頁 `import Base` 那一行之後——寫在前面的話頁面級 <link> 會排到
// Base 前面，頁面級規則如果需要蓋過 Base 級同具體度的規則，順序反了就會靜靜地輸掉。
// （`.chip-xs` 是這個陷阱的真實案例：拆檔規劃時它一度要被分進 `dice.css`——原始
// global.css 裡它離 `.chip` 300 多行、緊貼著骰子卡片那段——但兩者具體度相同又
// 套在同一顆按鈕上（`class="chip chip-xs"`），勝負全看檔案順序，所以最後刻意跟
// `.chip` 一起留在 `components.css`，不讓兩者的相對順序去賭哪個頁面先載哪個檔。）
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/chrome.css';
import '../styles/content.css';
import '../styles/components.css';
import data from '../generated/tree.json';
import { FEATURES } from '../lib/flags';
import { GUIDE_PAGES } from '../lib/glossary-groups';

interface Props {
  title: string;
  /**
   * 這一頁不要被搜尋引擎收錄（目前只有 404 頁用）。
   * 開起來會同時做兩件事：省略 canonical、加上 `<meta name="robots" content="noindex">`。
   */
  noIndex?: boolean;
}

const { title, noIndex = false } = Astro.props;

/**
 * 目前所在的分頁，給導覽列標 `aria-current="page"`（金色字＋底下一條金線）。
 *
 * 尾斜線要先剝掉：Astro 建出來的是 `/dice/index.html`，瀏覽器上的路徑是 `/dice/`，
 * 但導覽列寫的是 `/dice`，直接比字串永遠不相等。
 * `startsWith(href + '/')` 是給 /guide 用的——站在 /guide/mechanics 時，「遊戲介紹」
 * 這個下拉本身也該亮起來。首頁例外處理，否則 '/' 會match到每一頁。
 */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
/**
 * 「遊戲介紹」下拉本身要不要標 `aria-current`。
 *
 * ⚠️ 判準是「下拉裡**任何一頁**」，不是只有 `/guide`：2026-08-26 把 `/tactic` 與 `/boss`
 * 收進這個下拉之後，只看 `/guide` 的話，站在戰術頁時導覽列上零提示——下拉是收起來的，
 * 裡面那條 `aria-current` 使用者根本看不到。
 */
const guideCurrent = ['/guide', '/tactic', '/boss'].some(href => isCurrent(href));

/**
 * 分頁標題的站名前綴。格式是「站名 | 分頁名」，站名在前（2026-08-22 定案）。
 * ⚠️ 不要改成破折號：2026-08-18 明確要求分頁標題不帶破折號，`tests/e2e/tree.spec.ts` 的 R 有守。
 */
const SITE_NAME = 'Random Dice 2 wiki';

/** 連結預覽卡片的標題。全站固定，不隨分頁變動——理由見 <head> 裡的說明。 */
const OG_TITLE = 'Random Dice 2 wiki - Fan made';
/** 站台描述。<meta name="description">（給搜尋引擎）與連結預覽共用同一句，不維護兩份。 */
const DESCRIPTION = 'Random Dice 2 骰子樹非官方玩家攻略站：收錄全部節點、解鎖條件與前置關係。';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL('/favicon.png', Astro.site).href;
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      data-enter：進場動畫的總開關，規則在 src/styles/base.css。
      ⚠️ 三件事綁在一起，動其中一件之前先讀完：
      (1) 必須是 `is:inline` 而且留在這裡（head、任何卡片之前）。Astro 的一般 script 會被
          打包成 type=module，也就是 defer——要等整份 HTML 解析完才跑，卡片會先以「已經
          定位」的樣子進 DOM，之後才被套上起點。同步的 inline script 在解析到卡片之前就
          已經把屬性掛好了（建置產物確認過：它排在 title 之前，第一張卡片之前）。
      (2) 不要改回伺服器端輸出的 html 屬性：那樣沒有 JS 的環境會永遠留著它，動畫會一直掛在
          卡片上。2026-08-26 實測那會咬到 E2E 的 C11（javaScriptEnabled: false 之下
          Playwright 的 actionability 一直判定元素 not stable，30 秒逾時）。由腳本掛的話，
          沒有 JS ＝ 完全沒有進場動畫，順帶也不會有「/dice 用 [hidden] 篩選、切回來時動畫
          重播」的問題。
      (3) 拿掉它的 setTimeout 在頁尾那支 script 裡，理由寫在那裡。
    -->
    <script is:inline>
      document.documentElement.setAttribute('data-enter', '');
    </script>
    <title>{SITE_NAME} | {title}</title>
    <!--
      canonical：告訴搜尋引擎「這一頁的正規網址是哪一個」。同一份內容被多個網址打得到時
      （帶追蹤參數的連結、有無尾斜線、日後的自訂網域），沒有這一行就會被分成好幾份重複內容，
      權重也跟著散掉。網址用 astro.config.mjs 的 `site` 組出來的絕對網址，跟 og:url 同一個。

      noIndex 的頁面刻意不輸出 canonical：那種頁面本來就不該被收錄，指一個正規網址給它
      反而是在說「這個網址值得索引」。
    -->
    {!noIndex && <link rel="canonical" href={pageUrl} />}
    {noIndex && <meta name="robots" content="noindex" />}
    <!-- 分頁圖示用陰陽骰子（節點 4008）的骰子本體，不含節點底板：底板在 32px 下會吃掉四周
         約四分之一的面積，把中間的陰陽符號擠到看不清。圖是方形畫布置中的透明 PNG——favicon
         的顯示位置是正方形，直接放長方形圖會被壓扁。 -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={DESCRIPTION} />

    <!--
      連結預覽（貼進 Discord／LINE／Twitter 等聊天室時展開的卡片）。

      標題刻意**全站固定**、不帶頁名：貼出去的是「這個站」，收到連結的人要先認出它是什麼，
      而不是「骰子樹」這種只有站內才有意義的分頁名。沒有這幾行的時候，各平台是拿 <title>
      湊出來的，顯示成「Random Dice 2 wiki | 骰子樹」。

      og:url 與 og:image 一定要是絕對網址（規格要求，相對路徑多數平台直接不顯示）——
      靠 astro.config.mjs 的 `site` 組出來，不在這裡再寫死一次網域。
    -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={OG_TITLE} />
    <meta property="og:title" content={OG_TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <!-- og:url 吃跟 canonical 同一個判斷。404 頁是 Cloudflare Pages 拿來回**任何**未知
         路徑的那一份，`pageUrl` 卻固定是 `/404/`——貼一個失效連結到聊天室時，卡片會宣稱
         自己代表 `/404/`，那既不是使用者貼的網址，也不是這份檔案實際被服務的路徑。
         省略它，各平台會退回用實際請求的網址。 -->
    {!noIndex && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={OG_TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body>
    <!-- id="site-nav"：讓 /tree 頁的 tree-canvas.ts 能精準抓到「全站導覽列」這個 nav，
         不會跟同頁另一個 <nav id="branch-nav">（桌機側欄分支跳轉）搞混，用來量測
         這個 nav 的實際渲染高度（見 tree-canvas.ts 的 updateNavHeight() 說明）。 -->
    <nav id="site-nav">
      <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>rd2-wiki</a>
      <a href="/tree" aria-current={isCurrent('/tree') ? 'page' : undefined}>骰子樹</a>
      <a href="/dice" aria-current={isCurrent('/dice') ? 'page' : undefined}>圖鑑</a>
      <a href="/board" aria-current={isCurrent('/board') ? 'page' : undefined}>骰盤</a>
      <a href="/sim" aria-current={isCurrent('/sim') ? 'page' : undefined}>骰子樹-模擬器(beta)</a>
      <!--
        「遊戲介紹」用 <details> 而不是自己刻一個下拉：<summary> 本來就能 Tab 聚焦、能按
        Enter／Space 開合，螢幕閱讀器也會念出展開狀態。自訂元素要補齊這些至少三十行，
        而且補漏一項就是一個只有滑鼠能用的選單。底下的 <script> 只加兩件 <details> 沒有的
        事：點外面關掉、按 Esc 關掉。沒有 JS 時它仍然是一個能開能關的選單。
      -->
      <details class="nav-menu">
        <summary aria-current={guideCurrent ? 'page' : undefined}>遊戲介紹</summary>
        <div class="nav-menu-items">
          <a href="/guide" aria-current={path === '/guide' ? 'page' : undefined}>總覽</a>
          {GUIDE_PAGES.map(page => (
            <a
              href={`/guide/${page.slug}`}
              aria-current={path === `/guide/${page.slug}` ? 'page' : undefined}
            >
              {page.title}
            </a>
          ))}
          <!-- 戰術與 Boss 收在這個下拉裡（Yuki 2026-08-26 指定）：它們跟上面幾頁一樣是
               「遊戲有什麼」的說明，不是站台的互動工具（骰子樹／圖鑑／骰盤／模擬器）。
               ⚠️ 放進來就要一起改上面那個 `guideCurrent`，否則站在 /tactic 時整個下拉不會亮起來，
               使用者在導覽列上看不出自己在哪一區。 -->
          <a href="/tactic" aria-current={isCurrent('/tactic') ? 'page' : undefined}>戰術</a>
          <a href="/boss" aria-current={isCurrent('/boss') ? 'page' : undefined}>Boss</a>
        </div>
      </details>
      {FEATURES.contributeLink && (
        <a href="/about" aria-current={isCurrent('/about') ? 'page' : undefined}>貢獻</a>
      )}
      <!-- 顯示「上次更新」而非資料版本號：日期取自資料正本 SVG 的 data-updated 屬性
           （tools/build-data.ts 解析進 meta.updated），會隨資料更新自動變動，
           不是寫死在頁面上的字串。 -->
      <span class="nav-updated">上次更新 {data.meta.updated}</span>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      本站為非官方（fan-made）玩家攻略站，與 111% 無隸屬關係。<br />
      遊戲圖示與文字著作權屬 111 Percent Inc.，程式碼採 MIT 授權。
    </footer>
    <script>
      // 導覽列高度寫進 --nav-h。導覽列改成 position: sticky 之後，沾在它底下的東西
      // （/dice 的篩選列）與錨點跳轉的偏移量每一頁都要用得到，所以在這裡裝，不再只有
      // /tree 有。/tree 會由 tree-canvas.ts 再裝一次，兩者寫同一個值、互不干擾。
      import { installNavHeight } from '../lib/nav-height.js';
      installNavHeight();

      // 進場動畫跑完就把 data-enter 拿掉，否則 /dice 用 [hidden] 篩選、卡片切回來時
      // animation 會重播（display: none 的元素重新顯示時動畫會從頭跑）。
      // ⚠️ 不能改用 animationend 收尾：display: none 的元素不派發那個事件，41 張卡片裡只要
      // 有一張正被篩掉就永遠等不到最後一張。
      // ⚠️ 長度一律從 CSS 讀，不要在這裡寫第二份數字（CLAUDE.md 的規則）。三個值都要讀：
      // 動畫本身 + 最大延遲階數 × 每階，最後再加一點餘裕。
      // ⚠️ **一定要用 cssMs() 不是裸的 parseFloat**：Astro 的 CSS 壓縮會把 `440ms` 改寫成
      // `.44s`，parseFloat 會拿到 0.44 而不是 440，於是 data-enter 在 ~957ms 就被拿掉、
      // 41 張卡片裡 36 張的動畫還沒跑完就被切斷（2026-08-26 code review 抓到，實測過）。
      // 這件事**只在建置產物裡發生**，astro dev 不壓縮，本機開發完全看不出來。
      // ⚠️ --p-stagger-max 是無單位的純數字，要走 cssNumber() 不是 cssMs()。
      import { cssMs, cssNumber } from '../lib/css-ms.js';
      window.setTimeout(
        () => document.documentElement.removeAttribute('data-enter'),
        cssMs('--t-slow', 440) + cssNumber('--p-stagger-max', 8) * cssMs('--p-stagger', 80) + 100,
      );

      // <details> 唯一缺的兩件事：點到選單外面、以及按 Esc，都要收起來。
      // 沒有這兩條的話，選單一開就只能再點一次 summary 才關得掉——在手機上等於擋住半頁。
      const menus = [...document.querySelectorAll<HTMLDetailsElement>('#site-nav .nav-menu')];
      const closeAll = (except?: Element) => {
        for (const m of menus) if (m !== except) m.open = false;
      };
      document.addEventListener('click', event => {
        const inside = menus.find(m => m.contains(event.target as Node));
        closeAll(inside ?? undefined);
      });
      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        const open = menus.find(m => m.open);
        if (!open) return;
        open.open = false;
        // 焦點還給觸發它的 <summary>，否則按下 Esc 之後焦點掉回 <body>，下一次 Tab 會從
        // 頁面最上面重新開始。
        open.querySelector('summary')?.focus();
      });
    </script>
  </body>
</html>
