---
// 全站共用版面：導覽列、頁尾版權聲明。
// 導覽列只放已上線的頁面。「貢獻」入口目前由 src/lib/flags.ts 的 FEATURES.contributeLink
// 暫時關掉（頁面本身還在，只是不從導覽列曝光）。
import '../styles/global.css';
import data from '../generated/tree.json';
import { FEATURES } from '../lib/flags';
import { GUIDE_PAGES } from '../lib/glossary-groups';

interface Props {
  title: string;
  /**
   * 這一頁不要被搜尋引擎收錄（目前只有 404 頁用）。
   * 開起來會同時做兩件事：省略 canonical、加上 `<meta name="robots" content="noindex">`。
   */
  noIndex?: boolean;
}

const { title, noIndex = false } = Astro.props;

/**
 * 分頁標題的站名前綴。格式是「站名 | 分頁名」，站名在前（2026-08-22 定案）。
 * ⚠️ 不要改成破折號：2026-08-18 明確要求分頁標題不帶破折號，`tests/e2e/tree.spec.ts` 的 R 有守。
 */
const SITE_NAME = 'Random Dice 2 wiki';

/** 連結預覽卡片的標題。全站固定，不隨分頁變動——理由見 <head> 裡的說明。 */
const OG_TITLE = 'Random Dice 2 wiki - Fan made';
/** 站台描述。<meta name="description">（給搜尋引擎）與連結預覽共用同一句，不維護兩份。 */
const DESCRIPTION = 'Random Dice 2 骰子樹非官方玩家攻略站：收錄全部節點、解鎖條件與前置關係。';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL('/favicon.png', Astro.site).href;
---

<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE_NAME} | {title}</title>
    <!--
      canonical：告訴搜尋引擎「這一頁的正規網址是哪一個」。同一份內容被多個網址打得到時
      （帶追蹤參數的連結、有無尾斜線、日後的自訂網域），沒有這一行就會被分成好幾份重複內容，
      權重也跟著散掉。網址用 astro.config.mjs 的 `site` 組出來的絕對網址，跟 og:url 同一個。

      noIndex 的頁面刻意不輸出 canonical：那種頁面本來就不該被收錄，指一個正規網址給它
      反而是在說「這個網址值得索引」。
    -->
    {!noIndex && <link rel="canonical" href={pageUrl} />}
    {noIndex && <meta name="robots" content="noindex" />}
    <!-- 分頁圖示用陰陽骰子（節點 4008）的骰子本體，不含節點底板：底板在 32px 下會吃掉四周
         約四分之一的面積，把中間的陰陽符號擠到看不清。圖是方形畫布置中的透明 PNG——favicon
         的顯示位置是正方形，直接放長方形圖會被壓扁。 -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={DESCRIPTION} />

    <!--
      連結預覽（貼進 Discord／LINE／Twitter 等聊天室時展開的卡片）。

      標題刻意**全站固定**、不帶頁名：貼出去的是「這個站」，收到連結的人要先認出它是什麼，
      而不是「骰子樹」這種只有站內才有意義的分頁名。沒有這幾行的時候，各平台是拿 <title>
      湊出來的，顯示成「Random Dice 2 wiki | 骰子樹」。

      og:url 與 og:image 一定要是絕對網址（規格要求，相對路徑多數平台直接不顯示）——
      靠 astro.config.mjs 的 `site` 組出來，不在這裡再寫死一次網域。
    -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={OG_TITLE} />
    <meta property="og:title" content={OG_TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <!-- og:url 吃跟 canonical 同一個判斷。404 頁是 Cloudflare Pages 拿來回**任何**未知
         路徑的那一份，`pageUrl` 卻固定是 `/404/`——貼一個失效連結到聊天室時，卡片會宣稱
         自己代表 `/404/`，那既不是使用者貼的網址，也不是這份檔案實際被服務的路徑。
         省略它，各平台會退回用實際請求的網址。 -->
    {!noIndex && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={OG_TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body>
    <!-- id="site-nav"：讓 /tree 頁的 tree-canvas.ts 能精準抓到「全站導覽列」這個 nav，
         不會跟同頁另一個 <nav id="branch-nav">（桌機側欄分支跳轉）搞混，用來量測
         這個 nav 的實際渲染高度（見 tree-canvas.ts 的 updateNavHeight() 說明）。 -->
    <nav id="site-nav">
      <a href="/">rd2-wiki</a>
      <a href="/tree">骰子樹</a>
      <a href="/dice">圖鑑</a>
      <!--
        「遊戲介紹」用 <details> 而不是自己刻一個下拉：<summary> 本來就能 Tab 聚焦、能按
        Enter／Space 開合，螢幕閱讀器也會念出展開狀態。自訂元素要補齊這些至少三十行，
        而且補漏一項就是一個只有滑鼠能用的選單。底下的 <script> 只加兩件 <details> 沒有的
        事：點外面關掉、按 Esc 關掉。沒有 JS 時它仍然是一個能開能關的選單。
      -->
      <details class="nav-menu">
        <summary>遊戲介紹</summary>
        <div class="nav-menu-items">
          <a href="/guide">總覽</a>
          {GUIDE_PAGES.map(page => <a href={`/guide/${page.slug}`}>{page.title}</a>)}
        </div>
      </details>
      {FEATURES.contributeLink && <a href="/about">貢獻</a>}
      <!-- 顯示「上次更新」而非資料版本號：日期取自資料正本 SVG 的 data-updated 屬性
           （tools/build-data.ts 解析進 meta.updated），會隨資料更新自動變動，
           不是寫死在頁面上的字串。 -->
      <span style="margin-left:auto;color:var(--muted)">上次更新 {data.meta.updated}</span>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      本站為非官方（fan-made）玩家攻略站，與 111% 無隸屬關係。<br />
      遊戲圖示與文字著作權屬 111 Percent Inc.，程式碼採 MIT 授權。
    </footer>
    <script>
      // <details> 唯一缺的兩件事：點到選單外面、以及按 Esc，都要收起來。
      // 沒有這兩條的話，選單一開就只能再點一次 summary 才關得掉——在手機上等於擋住半頁。
      const menus = [...document.querySelectorAll<HTMLDetailsElement>('#site-nav .nav-menu')];
      const closeAll = (except?: Element) => {
        for (const m of menus) if (m !== except) m.open = false;
      };
      document.addEventListener('click', event => {
        const inside = menus.find(m => m.contains(event.target as Node));
        closeAll(inside ?? undefined);
      });
      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        const open = menus.find(m => m.open);
        if (!open) return;
        open.open = false;
        // 焦點還給觸發它的 <summary>，否則按下 Esc 之後焦點掉回 <body>，下一次 Tab 會從
        // 頁面最上面重新開始。
        open.querySelector('summary')?.focus();
      });
    </script>
  </body>
</html>
