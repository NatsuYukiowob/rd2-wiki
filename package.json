{
  "name": "rd2-wiki",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pretest": "npm run build:data",
    "test": "vitest run",
    "test:watch": "vitest",
    "split": "tsx tools/split-svg.ts",
    "normalize": "tsx tools/normalize-svg.ts data/dice-tree.svg",
    "preview": "tsx tools/build-preview-svg.ts",
    "validate": "tsx tools/validate.ts",
    "typecheck": "tsc --noEmit",
    "add-icon": "tsx tools/add-icon.ts",
    "render-nodes": "tsx tools/render-nodes.ts",
    "build:data": "tsx tools/build-data.ts",
    "compare": "tsx tools/compare-computed.ts",
    "build": "npm run build:data && astro build",
    "e2e:snapshots": "docker run --rm --network host --user $(id -u):$(id -g) -e HOME=/tmp -e CI=1 -e E2E_SNAPSHOTS=1 -e E2E_PORT=4397 -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.62.1-noble npx playwright test tests/e2e/tree.spec.ts -g 'F\\.' --project=desktop",
    "e2e:snapshots:update": "npm run e2e:snapshots -- --update-snapshots",
    "dev": "npm run build:data && astro dev",
    "pree2e": "npm run build",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@playwright/test": "^1.49.0",
    "@types/node": "^24.0.0",
    "astro": "^5.0.0",
    "linkedom": "^0.18.0",
    "serve": "^14.2.0",
    "sharp": "^0.34.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
